<?xml version="1.0"?>
<sdf version="1.6">
  <world name="factory_environment">
    <!-- Direct Light to prevent online fetching -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry>
            <box>
              <size>26 26 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>26 26 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>10 10 -0.025 0 0 0</pose>
    </model>

    <!-- Walls -->
    <model name="north_wall">
      <static>true</static>
      <pose>10 22 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>24 0.25 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>24 0.25 3.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static>
      <pose>10 -2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>24 0.25 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>24 0.25 3.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static>
      <pose>-2 10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.25 24 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.25 24 3.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static>
      <pose>22 10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.25 24 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.25 24 3.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 5 Rows of Desks/Machines with 4m spacing -->
    <model name="desk_row_1">
      <static>true</static>
      <pose>10 18 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 1.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 1.2 1.2</size></box></geometry><material><ambient>0.4 0.5 0.6 1</ambient><diffuse>0.4 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="desk_row_2">
      <static>true</static>
      <pose>10 14 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 1.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 1.2 1.2</size></box></geometry><material><ambient>0.4 0.5 0.6 1</ambient><diffuse>0.4 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="desk_row_3">
      <static>true</static>
      <pose>10 10 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 1.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 1.2 1.2</size></box></geometry><material><ambient>0.4 0.5 0.6 1</ambient><diffuse>0.4 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="desk_row_4">
      <static>true</static>
      <pose>10 6 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 1.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 1.2 1.2</size></box></geometry><material><ambient>0.4 0.5 0.6 1</ambient><diffuse>0.4 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="desk_row_5">
      <static>true</static>
      <pose>10 2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 1.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 1.2 1.2</size></box></geometry><material><ambient>0.4 0.5 0.6 1</ambient><diffuse>0.4 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Dynamic Workers -->
    <!-- Gazebo actors are visual animations only; these proxy cylinders provide
         collision geometry so /scan and Nav2 costmaps can see moving workers. -->
    <model name="worker_1_scan_proxy">
      <static>false</static>
      <pose>2 4 0.75 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><cylinder><radius>0.24</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 0.25</ambient><diffuse>0.9 0.1 0.1 0.25</diffuse></material>
          <transparency>0.75</transparency>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 2 4 0.75 0 0 0;16 18 4 0.75 0 0 0;18 18 4 0.75 0 0 3.14159;34 2 4 0.75 0 0 3.14159;36 2 4 0.75 0 0 6.28318</trajectory>
      </plugin>
    </model>

    <model name="worker_2_scan_proxy">
      <static>false</static>
      <pose>18 8 0.75 0 0 3.14159</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><cylinder><radius>0.24</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 0.25</ambient><diffuse>0.9 0.1 0.1 0.25</diffuse></material>
          <transparency>0.75</transparency>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 18 8 0.75 0 0 3.14159;16 2 8 0.75 0 0 3.14159;18 2 8 0.75 0 0 6.28318;34 18 8 0.75 0 0 6.28318;36 18 8 0.75 0 0 9.42477</trajectory>
      </plugin>
    </model>

    <model name="worker_3_scan_proxy">
      <static>false</static>
      <pose>2 20 0.75 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><cylinder><radius>0.24</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 0.25</ambient><diffuse>0.9 0.1 0.1 0.25</diffuse></material>
          <transparency>0.75</transparency>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 2 20 0.75 0 0 0;16 18 20 0.75 0 0 0;18 18 20 0.75 0 0 3.14159;34 2 20 0.75 0 0 3.14159;36 2 20 0.75 0 0 6.28318</trajectory>
      </plugin>
    </model>

    <model name="worker_4_scan_proxy">
      <static>false</static>
      <pose>20 8 0.75 0 0 1.5708</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><cylinder><radius>0.24</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 0.25</ambient><diffuse>0.9 0.1 0.1 0.25</diffuse></material>
          <transparency>0.75</transparency>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 20 8 0.75 0 0 1.5708;4 20 12 0.75 0 0 1.5708;5.5 20 12 0.75 0 0 3.1416;25.5 0 12 0.75 0 0 3.1416;27 0 12 0.75 0 0 4.7124;31 0 8 0.75 0 0 4.7124;32.5 0 8 0.75 0 0 6.2832;52.5 20 8 0.75 0 0 6.2832;54 20 8 0.75 0 0 7.8540</trajectory>
      </plugin>
    </model>

    <model name="worker_5_scan_proxy">
      <static>false</static>
      <pose>0 16 0.75 0 0 1.5708</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><cylinder><radius>0.24</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.18</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.9 0.1 0.1 0.25</ambient><diffuse>0.9 0.1 0.1 0.25</diffuse></material>
          <transparency>0.75</transparency>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 0 16 0.75 0 0 1.5708;4 0 20 0.75 0 0 1.5708;5.5 0 20 0.75 0 0 0;25.5 20 20 0.75 0 0 0;27 20 20 0.75 0 0 -1.5708;31 20 16 0.75 0 0 -1.5708;32.5 20 16 0.75 0 0 -3.1416;52.5 0 16 0.75 0 0 -3.1416;54 0 16 0.75 0 0 -4.7124</trajectory>
      </plugin>
    </model>

    <!-- Worker 1: Patrols aisle Y=4 (Turns locally around points) -->
    <actor name="worker_1">
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <pose>2 4 0 0 0 0</pose>
      <animation name="walking"><filename>walk.dae</filename><scale>1.0</scale><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop>
        <delay_start>0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.0</time><pose>2 4 0 0 0 0</pose></waypoint>
          <!-- Walks 16m East. takes 16s -->
          <waypoint><time>16.0</time><pose>18 4 0 0 0 0</pose></waypoint>
          <!-- Turns 180 degrees over 2s to not look like teleportation -->
          <waypoint><time>18.0</time><pose>18 4 0 0 0 3.14159</pose></waypoint>
          <!-- Walks 16m West -->
          <waypoint><time>34.0</time><pose>2 4 0 0 0 3.14159</pose></waypoint>
          <!-- Turns 180 degrees back E (uses 2*PI to avoid spin-around glitch) -->
          <waypoint><time>36.0</time><pose>2 4 0 0 0 6.28318</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Worker 2: Patrols aisle Y=8 -->
    <actor name="worker_2">
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <pose>18 8 0 0 0 3.14159</pose>
      <animation name="walking"><filename>walk.dae</filename><scale>1.0</scale><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop>
        <delay_start>2.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.0</time><pose>18 8 0 0 0 3.14159</pose></waypoint>
          <!-- Walks 16m West -->
          <waypoint><time>16.0</time><pose>2 8 0 0 0 3.14159</pose></waypoint>
          <!-- Turns 180 degrees -->
          <waypoint><time>18.0</time><pose>2 8 0 0 0 6.28318</pose></waypoint>
          <!-- Walks 16m East -->
          <waypoint><time>34.0</time><pose>18 8 0 0 0 6.28318</pose></waypoint>
          <!-- Turns 180 degrees back W -->
          <waypoint><time>36.0</time><pose>18 8 0 0 0 9.42477</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Worker 3: Patrols aisle Y=20 (Back Row) -->
    <actor name="worker_3_back">
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <pose>2 20 0 0 0 0</pose>
      <animation name="walking"><filename>walk.dae</filename><scale>1.0</scale><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop>
        <delay_start>1.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint><time>0.0</time><pose>2 20 0 0 0 0</pose></waypoint>
          <waypoint><time>16.0</time><pose>18 20 0 0 0 0</pose></waypoint>
          <waypoint><time>18.0</time><pose>18 20 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>34.0</time><pose>2 20 0 0 0 3.14159</pose></waypoint>
          <waypoint><time>36.0</time><pose>2 20 0 0 0 6.28318</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Worker 4: Loops entirely around Row 3 (Y=10) -->
    <actor name="worker_4_right">
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <pose>20 8 0 0 0 1.5708</pose>
      <animation name="walking"><filename>walk.dae</filename><scale>1.0</scale><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop>
        <delay_start>0.5</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <!-- Start moving North -->
          <waypoint><time>0.0</time><pose>20 8 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>4.0</time><pose>20 12 0 0 0 1.5708</pose></waypoint>
          <!-- Turn West at corner (90 deg over 1.5s) -->
          <waypoint><time>5.5</time><pose>20 12 0 0 0 3.1416</pose></waypoint>
          <!-- Move West -->
          <waypoint><time>25.5</time><pose>0 12 0 0 0 3.1416</pose></waypoint>
          <!-- Turn South -->
          <waypoint><time>27.0</time><pose>0 12 0 0 0 4.7124</pose></waypoint>
          <!-- Move South -->
          <waypoint><time>31.0</time><pose>0 8 0 0 0 4.7124</pose></waypoint>
          <!-- Turn East -->
          <waypoint><time>32.5</time><pose>0 8 0 0 0 6.2832</pose></waypoint>
          <!-- Move East -->
          <waypoint><time>52.5</time><pose>20 8 0 0 0 6.2832</pose></waypoint>
          <!-- Turn North to complete loop -->
          <waypoint><time>54.0</time><pose>20 8 0 0 0 7.8540</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Worker 5: Loops entirely around Row 1 (Y=18). Avoids the bottom-left map origin -->
    <actor name="worker_5_left">
      <skin><filename>walk.dae</filename><scale>1.0</scale></skin>
      <pose>0 16 0 0 0 1.5708</pose>
      <animation name="walking"><filename>walk.dae</filename><scale>1.0</scale><interpolate_x>true</interpolate_x></animation>
      <script>
        <loop>true</loop>
        <delay_start>1.5</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <!-- Start moving North -->
          <waypoint><time>0.0</time><pose>0 16 0 0 0 1.5708</pose></waypoint>
          <waypoint><time>4.0</time><pose>0 20 0 0 0 1.5708</pose></waypoint>
          <!-- Turn East at corner -->
          <waypoint><time>5.5</time><pose>0 20 0 0 0 0</pose></waypoint>
          <!-- Move East -->
          <waypoint><time>25.5</time><pose>20 20 0 0 0 0</pose></waypoint>
          <!-- Turn South -->
          <waypoint><time>27.0</time><pose>20 20 0 0 0 -1.5708</pose></waypoint>
          <!-- Move South -->
          <waypoint><time>31.0</time><pose>20 16 0 0 0 -1.5708</pose></waypoint>
          <!-- Turn West -->
          <waypoint><time>32.5</time><pose>20 16 0 0 0 -3.1416</pose></waypoint>
          <!-- Move West -->
          <waypoint><time>52.5</time><pose>0 16 0 0 0 -3.1416</pose></waypoint>
          <!-- Turn North to complete loop -->
          <waypoint><time>54.0</time><pose>0 16 0 0 0 -4.7124</pose></waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>

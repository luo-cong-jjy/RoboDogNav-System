#!/usr/bin/env python3

from pathlib import Path

import numpy as np
import rclpy
from rclpy.node import Node
from sensor_msgs.msg import PointCloud2
from sensor_msgs_py import point_cloud2
from std_msgs.msg import Header


class PcdSlicePublisher(Node):
    def __init__(self):
        super().__init__("pcd_slice_publisher")
        self.declare_parameter("pcd_path", "")
        self.declare_parameter("topic", "/LIDAR/POINTS")
        self.declare_parameter("frame_id", "lidar_link")
        self.declare_parameter("publish_hz", 1.0)
        self.declare_parameter("min_height", -0.30)
        self.declare_parameter("max_height", 0.30)
        self.declare_parameter("range_min", 0.20)
        self.declare_parameter("range_max", 30.0)
        self.declare_parameter("max_points", 80000)

        topic = self.get_parameter("topic").get_parameter_value().string_value
        publish_hz = self.get_parameter("publish_hz").get_parameter_value().double_value
        if publish_hz <= 0.0:
            raise ValueError("publish_hz must be positive")

        self.publisher = self.create_publisher(PointCloud2, topic, 10)
        self.points = self.load_points()
        self.get_logger().info(
            f"publishing {len(self.points)} sliced PCD points on {topic}"
        )
        self.create_timer(1.0 / publish_hz, self.publish_cloud)

    def load_points(self):
        pcd_path = Path(self.get_parameter("pcd_path").get_parameter_value().string_value)
        if not pcd_path.exists():
            raise FileNotFoundError(str(pcd_path))

        header, data_offset = self.read_header(pcd_path)
        fields = header["FIELDS"]
        sizes = [int(value) for value in header["SIZE"]]
        counts = [int(value) for value in header["COUNT"]]
        points_count = int(header["POINTS"][0])
        data_type = header["DATA"][0]
        if data_type != "binary":
            raise ValueError(f"only binary PCD is supported, got DATA {data_type}")

        offsets = {}
        point_step = 0
        for name, size, count in zip(fields, sizes, counts):
            offsets[name] = point_step
            point_step += size * count

        for required in ("x", "y", "z"):
            if required not in offsets:
                raise ValueError(f"PCD missing required field: {required}")

        raw = np.memmap(
            pcd_path,
            dtype=np.uint8,
            mode="r",
            offset=data_offset,
            shape=(points_count, point_step),
        )
        x = raw[:, offsets["x"]: offsets["x"] + 4].copy().view("<f4").reshape(-1)
        y = raw[:, offsets["y"]: offsets["y"] + 4].copy().view("<f4").reshape(-1)
        z = raw[:, offsets["z"]: offsets["z"] + 4].copy().view("<f4").reshape(-1)
        xyz = np.column_stack((x, y, z))

        min_height = self.get_parameter("min_height").get_parameter_value().double_value
        max_height = self.get_parameter("max_height").get_parameter_value().double_value
        range_min = self.get_parameter("range_min").get_parameter_value().double_value
        range_max = self.get_parameter("range_max").get_parameter_value().double_value
        max_points = self.get_parameter("max_points").get_parameter_value().integer_value

        ranges = np.hypot(xyz[:, 0], xyz[:, 1])
        mask = (
            np.isfinite(xyz).all(axis=1)
            & (xyz[:, 2] >= min_height)
            & (xyz[:, 2] <= max_height)
            & (ranges >= range_min)
            & (ranges <= range_max)
        )
        xyz = xyz[mask]
        if len(xyz) == 0:
            raise ValueError("PCD slice is empty; adjust height/range parameters")

        if max_points > 0 and len(xyz) > max_points:
            indices = np.linspace(0, len(xyz) - 1, max_points, dtype=np.int64)
            xyz = xyz[indices]

        self.get_logger().info(
            "loaded PCD slice from %s: points=%d z=[%.2f, %.2f] range=[%.2f, %.2f]"
            % (pcd_path, len(xyz), min_height, max_height, range_min, range_max)
        )
        return xyz.astype(np.float32)

    @staticmethod
    def read_header(path):
        header = {}
        with path.open("rb") as file_obj:
            while True:
                line = file_obj.readline()
                if not line:
                    raise ValueError("PCD header ended before DATA line")
                text = line.decode("ascii", errors="replace").strip()
                if not text or text.startswith("#"):
                    continue
                parts = text.split()
                header[parts[0]] = parts[1:]
                if parts[0] == "DATA":
                    return header, file_obj.tell()

    def publish_cloud(self):
        frame_id = self.get_parameter("frame_id").get_parameter_value().string_value
        msg = point_cloud2.create_cloud_xyz32(
            header=self.make_header(frame_id),
            points=self.points,
        )
        self.publisher.publish(msg)

    def make_header(self, frame_id):
        header = Header()
        header.stamp = self.get_clock().now().to_msg()
        header.frame_id = frame_id
        return header


def main():
    rclpy.init()
    node = PcdSlicePublisher()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()

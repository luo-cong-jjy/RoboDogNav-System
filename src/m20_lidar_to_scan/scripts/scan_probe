#!/usr/bin/env python3

import math

import rclpy
from rclpy.executors import ExternalShutdownException
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, HistoryPolicy, QoSProfile, ReliabilityPolicy
from sensor_msgs.msg import LaserScan


class ScanProbe(Node):
    def __init__(self):
        super().__init__("scan_probe")
        self.declare_parameter("topic", "/scan")
        self.declare_parameter("samples", 5)

        self.topic = self.get_parameter("topic").get_parameter_value().string_value
        self.samples = self.get_parameter("samples").get_parameter_value().integer_value
        self.count = 0
        self.done = False

        qos = QoSProfile(
            history=HistoryPolicy.KEEP_LAST,
            depth=10,
            reliability=ReliabilityPolicy.BEST_EFFORT,
            durability=DurabilityPolicy.VOLATILE,
        )
        self.create_subscription(LaserScan, self.topic, self.on_scan, qos)
        self.get_logger().info(f"waiting for LaserScan on {self.topic}")

    def on_scan(self, msg):
        self.count += 1
        finite_ranges = [value for value in msg.ranges if math.isfinite(value)]
        if finite_ranges:
            range_text = f"min={min(finite_ranges):.2f}m max={max(finite_ranges):.2f}m"
        else:
            range_text = "min=nan max=nan"

        self.get_logger().info(
            "sample=%d frame=%s ranges=%d finite=%d %s angle_min=%.3f "
            "angle_max=%.3f angle_increment=%.6f scan_time=%.3f"
            % (
                self.count,
                msg.header.frame_id,
                len(msg.ranges),
                len(finite_ranges),
                range_text,
                msg.angle_min,
                msg.angle_max,
                msg.angle_increment,
                msg.scan_time,
            )
        )

        if self.samples > 0 and self.count >= self.samples:
            self.done = True


def main():
    rclpy.init()
    node = ScanProbe()
    try:
        while rclpy.ok() and not node.done:
            rclpy.spin_once(node, timeout_sec=0.1)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()

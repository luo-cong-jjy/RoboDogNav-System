Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Navigation View1
        - /Robot1
        - /Mission1
      Splitter Ratio: 0.5
    Tree Height: 760
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.58
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: Robot Trace
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.55
      Cell Size: 0.5
      Class: rviz_default_plugins/Grid
      Color: 45; 48; 52
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Navigation View
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 160
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Axes
      Enabled: true
      Length: 0.8
      Name: Odom Axes
      Radius: 0.045
      Reference Frame: odom
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.45
      Name: TF Tree
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Tree:
        odom:
          base_link:
            {}
      Update Interval: 0
      Value: false
    - Class: rviz_default_plugins/RobotModel
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /robot_description
      Enabled: true
      Name: Robot
      Visual Enabled: true
      Value: true
    - Alpha: 1
      Axes Length: 0.28
      Axes Radius: 0.05
      Class: rviz_default_plugins/Odometry
      Color: 58; 92; 142
      Enabled: false
      Keep: 1
      Name: Raw Odom Pose
      Position Tolerance: 0.12
      Shape: Axes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /odom
      Value: false
    - Alpha: 0.95
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 43; 117; 232
      Enabled: true
      Head Length: 0.2
      Head Radius: 0.08
      Length: 0.25
      Line Style: Lines
      Line Width: 0.045
      Name: Robot Trace
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 43; 117; 232
      Pose Style: None
      Radius: 0.03
      Shaft Length: 0.2
      Shaft Radius: 0.04
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20_inspection/odom_trace
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Mission
      Marker Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20_inspection/mission_route_marker
      Namespaces:
        inspection_mission: true
        inspection_mission_labels: true
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Tracker Route
      Marker Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20_inspection/route_marker
      Namespaces:
        odom_route: true
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Current Goal Marker
      Marker Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20_inspection/current_goal_marker
      Namespaces:
        odom_waypoints: true
      Value: true
    - Alpha: 1
      Axes Length: 0.35
      Axes Radius: 0.055
      Class: rviz_default_plugins/Pose
      Color: 24; 111; 190
      Enabled: true
      Head Length: 0.2
      Head Radius: 0.08
      Name: Current Goal Pose
      Shaft Length: 0.45
      Shaft Radius: 0.035
      Shape: Axes
      Topic:
        Depth: 5
        Durability Policy: Volatile
        Filter size: 10
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20_inspection/current_goal
      Value: true
  Enabled: true
  Global Options:
    Background Color: 222; 221; 218
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    - Class: rviz_default_plugins/SetInitialPose
      Covariance x: 0.25
      Covariance y: 0.25
      Covariance yaw: 0.06853891909122467
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8.5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0.2
        Y: 0.6
        Z: 0.2
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.25
      Target Frame: odom
      Value: Orbit (rviz)
      Yaw: 3.14
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 980
  Hide Left Dock: false
  Hide Right Dock: true
  Selection:
    collapsed: false
  Time:
    collapsed: false
  Tool Properties:
    collapsed: false
  Views:
    collapsed: true
  Width: 1460
  X: 80
  Y: 80

#!/usr/bin/python3
# =============================================================================
# goal_pose_restamper_gazebo
# 所属模块：m20_nav2_system / scripts（Gazebo 链路专属副本）
# 职责：目标点时间戳转发节点。订阅原始目标点话题（如 RViz 2D Goal Pose），
#       把消息的时间戳重写后转发到 Nav2 实际使用的目标点话题。
# 背景：RViz 发出的目标点在经过恢复行为（spin/backup）等耗时流程后，其原始
#       时间戳可能已经"过期"，导致 Nav2 使用过期的 TF 变换。本节点把时间戳
#       置 0（或当前时间），让 TF 使用最新变换。
# 参数（ROS2 参数）：
#   input_topic    输入目标点话题（默认 /m20_nav2/goal_pose_raw）
#   output_topic   输出目标点话题（默认 /goal_pose）
#   use_zero_stamp true 时把时间戳置 0（用最新 TF）；false 时用当前时钟时间
# =============================================================================

import rclpy                                 # ROS2 Python 客户端库
from geometry_msgs.msg import PoseStamped    # 带时间戳的位姿消息
from rclpy.node import Node                  # ROS2 节点基类


class GoalPoseRestamper(Node):
    """目标点时间戳重写转发节点。"""

    def __init__(self):
        super().__init__("goal_pose_restamper_gazebo")
        # 输入话题：原始目标点（通常来自 RViz）
        self.input_topic = self.declare_parameter(
            "input_topic", "/m20_nav2/goal_pose_raw"
        ).value
        # 输出话题：Nav2 实际订阅的目标点话题
        self.output_topic = self.declare_parameter("output_topic", "/goal_pose").value
        # 是否把时间戳置 0（true=用最新 TF；false=用当前时间）
        self.use_zero_stamp = bool(self.declare_parameter("use_zero_stamp", True).value)

        # 创建发布器与订阅器，队列深度 10
        self.publisher = self.create_publisher(PoseStamped, self.output_topic, 10)
        self.subscription = self.create_subscription(
            PoseStamped, self.input_topic, self._on_goal, 10
        )

        self.get_logger().info(
            f"目标点时间戳转发已启动：{self.input_topic} -> {self.output_topic}"
        )

    def _on_goal(self, msg):
        """话题回调：复制消息内容并重写时间戳后发布。"""
        goal = PoseStamped()
        goal.header = msg.header    # 复制原始 header（保留 frame_id 等）
        goal.pose = msg.pose        # 复制原始位姿

        # RViz 目标点在恢复行为后可能变成旧时间戳；stamp=0 让 TF 使用最新变换。
        if self.use_zero_stamp:
            # 时间戳置 0：TF 缓冲会返回最新可用的变换
            goal.header.stamp.sec = 0
            goal.header.stamp.nanosec = 0
        else:
            # 或者使用当前时钟时间
            goal.header.stamp = self.get_clock().now().to_msg()

        self.publisher.publish(goal)   # 发布重写后的目标点
        # 打印转发日志，便于确认目标点来源
        self.get_logger().info(
            "转发目标点："
            f"frame={goal.header.frame_id}, "
            f"x={goal.pose.position.x:.2f}, "
            f"y={goal.pose.position.y:.2f}, "
            f"stamp={goal.header.stamp.sec}.{goal.header.stamp.nanosec:09d}"
        )


def main():
    """主入口：初始化节点并进入事件循环。"""
    rclpy.init()                     # 初始化 ROS2 客户端库
    node = GoalPoseRestamper()       # 创建节点
    try:
        rclpy.spin(node)             # 阻塞式旋转：处理回调直到被中断
    except KeyboardInterrupt:
        pass                         # Ctrl+C 正常退出
    finally:
        node.destroy_node()          # 清理节点
        if rclpy.ok():
            rclpy.shutdown()         # 关闭 rclpy


if __name__ == "__main__":
    main()

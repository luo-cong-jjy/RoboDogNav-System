                <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/>
            </material>
        </visual>
        <!-- 碰撞模型：轮子简化为圆柱 -->
        <collision>
            <origin xyz="0 0 0" rpy="1.57079632 0 0"/>
            <geometry>
                <cylinder length="0.054" radius="0.09"/>
            </geometry>
        </collision>
    </link>
    <!-- hl_wheel_joint：连续旋转关节（continuous 类型），左后驱动轮，无角度限位。 -->
    <joint name="hl_wheel_joint" type="continuous">
        <origin xyz="0 0.059676 -0.25" rpy="0 0 0"/>
        <parent link="hl_knee"/>
        <child link="hl_wheel"/>
        <axis xyz="0 -1 0"/>
        <limit effort="21.6" velocity="79.3"/>
    </joint>
    <!-- ==================== hr_hipx：右后腿髋关节横滚部件（绕 X 轴） ==================== -->
    <link name="hr_hipx">
        <inertial>
            <origin xyz="0.0110901558226165 -0.00875011717083631 0.000524936954718227" rpy="0 0 0"/>
            <mass value="0.261359958476582"/>
            <inertia ixx="0.000186" ixy="0.000025" ixz="0.000012" iyy="0.000371" iyz="0.000008" izz="0.000288"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://m20_nav2_system/models/meshes/hr_hipx.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/>
            </material>
        </visual>
        <!-- 碰撞模型：简化为圆柱 -->
        <collision>
            <origin xyz="0 -0.055 0" rpy="1.57079632 0 0"/>
            <geometry>
                <cylinder length="0.14" radius="0.048"/>
            </geometry>
        </collision>
    </link>
    <!-- hr_hipx_joint：固定连接 base_link 与 hr_hipx（fixed 类型），轮式模式下锁死。 -->
    <joint name="hr_hipx_joint" type="fixed">
        <origin xyz="-0.3141 -0.0685 0" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="hr_hipx"/>
        <axis xyz="-1 0 0"/>
        <limit lower="-0.436" upper="0.611" effort="76.4" velocity="22.4"/>
    </joint>
    <!-- ==================== hr_hipy：右后腿髋关节俯仰部件（绕 Y 轴） ==================== -->
    <link name="hr_hipy">
        <inertial>
            <origin xyz="0.00199199678434109 -0.0983704174694303 -0.13056065751366" rpy="0 0 0"/>
            <mass value="2.493"/>
            <inertia ixx="0.038878" ixy="-0.000022" ixz="0.000034" iyy="0.038053" iyz="0.005995" izz="0.003854"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://m20_nav2_system/models/meshes/hr_hipy.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/>
            </material>
        </visual>
        <!-- 碰撞模型 1：大腿杆简化为长方体 -->
        <collision>
            <origin xyz="0.01 -0.11 -0.125" rpy="0 0 0"/>
            <geometry>
                <box size="0.07 0.02 0.25"/>
            </geometry>
        </collision>
        <!-- 碰撞模型 2：大腿关节端简化为圆柱 -->
        <collision>
            <origin xyz="0 -0.11 -0.25" rpy="1.57079632 0 0"/>
            <geometry>
                <cylinder length="0.09" radius="0.05"/>
            </geometry>
        </collision>
    </link>
    <!-- hr_hipy_joint：固定连接 hr_hipx 与 hr_hipy（fixed 类型），轮式模式下锁死。 -->
    <joint name="hr_hipy_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="hr_hipx"/>
        <child link="hr_hipy"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-2.286" upper="2.583" effort="76.4" velocity="22.4"/>
    </joint>
    <!-- ==================== hr_knee：右后腿膝关节部件 ==================== -->
    <link name="hr_knee">
        <inertial>
            <origin xyz="-0.00341053036115846 -0.0027020185369851 -0.181287492263963" rpy="0 0 0"/>
            <mass value="1.26"/>
            <inertia ixx="0.012936" ixy="-0.000053" ixz="-0.000226" iyy="0.013123" iyz="0.001681" izz="0.001283"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://m20_nav2_system/models/meshes/hr_knee.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/>
            </material>
        </visual>
        <!-- 碰撞模型 1：小腿杆简化为长方体 -->
        <collision>
            <origin xyz="-0.015 0.015 -0.125" rpy="0 0 0"/>
            <geometry>
                <box size="0.06 0.025 0.25"/>
            </geometry>
        </collision>
        <!-- 碰撞模型 2：小腿关节端简化为圆柱 -->
        <collision>
            <origin xyz="0 -0.02 -0.25" rpy="1.57079632 0 0"/>
            <geometry>
                <cylinder length="0.1" radius="0.04"/>
            </geometry>
        </collision>
    </link>
    <!-- hr_knee_joint：固定连接 hr_hipy 与 hr_knee（fixed 类型），轮式模式下锁死。 -->
    <joint name="hr_knee_joint" type="fixed">
        <origin xyz="0 -0.0984 -0.25" rpy="0 0 0"/>
        <parent link="hr_hipy"/>
        <child link="hr_knee"/>
        <axis xyz="0 -1 0"/>
        <limit lower="-2.809" upper="2.792" effort="76.4" velocity="22.4"/>
    </joint>
    <!-- ==================== hr_wheel：右后轮 ==================== -->
    <link name="hr_wheel">
        <inertial>
            <origin xyz="6.09746291457824E-07 -0.00027900886004309 2.0131377032051E-07" rpy="0 0 0"/>
            <mass value="0.638"/>
            <inertia ixx="0.001535" ixy="0.0" ixz="0.0" iyy="0.002853" iyz="0.0" izz="0.001535"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://m20_nav2_system/models/meshes/hr_wheel.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/>
            </material>
        </visual>
        <!-- 碰撞模型：轮子简化为圆柱 -->
        <collision>
            <origin xyz="0 0 0" rpy="1.57079632 0 0"/>
            <geometry>
                <cylinder length="0.054" radius="0.09"/>
            </geometry>
        </collision>
    </link>
    <!-- hr_wheel_joint：连续旋转关节（continuous 类型），右后驱动轮，无角度限位。 -->
    <joint name="hr_wheel_joint" type="continuous">
        <origin xyz="0 -0.059676 -0.25" rpy="0 0 0"/>
        <parent link="hr_knee"/>
        <child link="hr_wheel"/>
        <axis xyz="0 -1 0"/>
        <limit effort="21.6" velocity="79.3"/>
    </joint>
    <!-- M20 顶部仿真雷达：Gazebo 发布硬件风格点云，launch 中再投影成 /scan 给 Nav2。 -->
    <!-- ==================== lidar_mount_link：雷达安装座（支架） ==================== -->
    <link name="lidar_mount_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.12"/>
            <inertia ixx="0.00012" ixy="0.0" ixz="0.0" iyy="0.00012" iyz="0.0" izz="0.00012"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.10" radius="0.028"/>
            </geometry>
            <material name="mount_dark">
                <color rgba="0.06 0.06 0.06 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.10" radius="0.028"/>
            </geometry>
        </collision>
    </link>
    <!-- base_link_to_lidar_mount：固定连接 base_link 与雷达安装座（fixed 类型），
         安装于车体前上方（x=0.26m，z=0.14m）。 -->
    <joint name="base_link_to_lidar_mount" type="fixed">
        <origin xyz="0.26 0 0.14" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="lidar_mount_link"/>
    </joint>
    <!-- ==================== lidar_link：3D 雷达本体（rslidar 风格） ==================== -->
    <link name="lidar_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.45"/>
            <inertia ixx="0.0012" ixy="0.0" ixz="0.0" iyy="0.0012" iyz="0.0" izz="0.0015"/>
        </inertial>
        <!-- 外观 1：雷达机身（深色圆柱） -->
        <visual name="lidar_body">
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.075" radius="0.060"/>
            </geometry>
            <material name="lidar_black">
                <color rgba="0.02 0.02 0.025 1"/>
            </material>
        </visual>
        <!-- 外观 2：雷达窗口（蓝色小方块，模拟激光出射窗口） -->
        <visual name="lidar_window">
            <origin xyz="0.030 0 0.004" rpy="0 0 0"/>
            <geometry>
                <box size="0.010 0.105 0.030"/>
            </geometry>
            <material name="lidar_window_blue">
                <color rgba="0.05 0.25 0.70 1"/>
            </material>
        </visual>
        <!-- 碰撞模型：简化为圆柱 -->
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.075" radius="0.060"/>
            </geometry>
        </collision>
    </link>
    <!-- base_link_to_lidar：固定连接 base_link 与雷达本体（fixed 类型），
         雷达位于车体前上方 z=0.22m 处（雷达扫描平面高度）。 -->
    <joint name="base_link_to_lidar" type="fixed">
        <origin xyz="0.26 0 0.22" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="lidar_link"/>
    </joint>
  <!-- ==================== gazebo：雷达传感器插件段 ==================== -->
  <!-- 为 lidar_link 附加射线传感器：m20_rslidar_points（ray 类型）。
       水平 360°（1800 线）、垂直 ±15°（16 线），量程 0.2~30m，
       带高斯噪声（均值 0，标准差 0.01）。
       通过 libgazebo_ros_ray_sensor.so 输出 sensor_msgs/PointCloud2，
       话题重映射为 /LIDAR/POINTS，坐标系为 lidar_link。 -->
  <gazebo reference="lidar_link">
    <material>Gazebo/Black</material>
    <sensor name="m20_rslidar_points" type="ray">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>1800</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265</min_angle>
            <max_angle>3.14159265</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.26179939</min_angle>
            <max_angle>0.26179939</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.20</min>
          <max>30.0</max>
          <resolution>0.02</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="m20_rslidar_points_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=/LIDAR/POINTS</remapping>
        </ros>
        <output_type>sensor_msgs/PointCloud2</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ==================== gazebo：四轮接触摩擦参数段 ==================== -->
  <!-- 为四个轮子设置地面接触参数：mu1/mu2 为库仑摩擦系数（纵向/侧向），
       kp/kd 为接触刚度与阻尼，保证轮式行驶不打滑。 -->
  <gazebo reference="fl_wheel">
    <mu1>1.2</mu1>
    <mu2>0.35</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="fr_wheel">
    <mu1>1.2</mu1>
    <mu2>0.35</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="hl_wheel">
    <mu1>1.2</mu1>
    <mu2>0.35</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <gazebo reference="hr_wheel">
    <mu1>1.2</mu1>
    <mu2>0.35</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
  </gazebo>

  <!-- ==================== gazebo：四轮驱动底盘插件 ==================== -->
  <!-- m20_four_wheel_drive 插件：订阅 /cmd_vel（Twist 速度指令），
       驱动 fl/fr/hl/hr 四个轮关节；按轮距 0.453m、轮半径 0.09m 计算差速，
       发布 /odom 里程计与 odom→base_link 的 TF；带指令超时保护（0.5s）。 -->
  <gazebo>
    <plugin name="m20_four_wheel_drive" filename="libm20_four_wheel_drive_plugin.so">
      <cmd_topic>/cmd_vel</cmd_topic>
      <odom_topic>/odom</odom_topic>
      <odom_frame_id>odom</odom_frame_id>
      <base_frame_id>base_link</base_frame_id>
      <front_left_joint>fl_wheel_joint</front_left_joint>
      <rear_left_joint>hl_wheel_joint</rear_left_joint>
      <front_right_joint>fr_wheel_joint</front_right_joint>
      <rear_right_joint>hr_wheel_joint</rear_right_joint>
      <wheel_radius>0.09</wheel_radius>
      <wheel_separation>0.453</wheel_separation>
      <wheel_velocity_sign>-1.0</wheel_velocity_sign>
      <max_wheel_torque>55.0</max_wheel_torque>
      <max_linear_speed>0.45</max_linear_speed>
      <max_angular_speed>1.05</max_angular_speed>
      <command_timeout_sec>0.5</command_timeout_sec>
      <update_rate_hz>100.0</update_rate_hz>
      <use_planar_velocity>true</use_planar_velocity>
      <publish_odom>true</publish_odom>
      <publish_tf>true</publish_tf>
    </plugin>
  </gazebo>
</robot>

<?xml version="1.0"?>
<!-- ==========================================================================
     package.xml：m20_nav2_system 包的清单文件（ROS2 ament_cmake 格式）。
     包定位：M20 机器人 Nav2 导航集成与验证的统一入口包，包含
     Gazebo 仿真 launch、Nav2 导航栈 launch、PCD 回放/验证工具、
     Gazebo 插件与多个 Python 脚本等。
     ========================================================================== -->
<package format="3">
  <name>m20_nav2_system</name>  <!-- 包名：与 CMakeLists.txt 中 project() 保持一致 -->
  <version>0.1.0</version>  <!-- 包版本号 -->
  <description>Unified M20 Nav2 integration and validation entry points.</description>  <!-- 包功能描述 -->
  <maintainer email="virdyn@example.com">virdyn</maintainer>  <!-- 包维护者及邮箱 -->
  <license>BSD-3-Clause</license>  <!-- 开源许可证：BSD 3-Clause -->

  <!-- 构建工具依赖：ament_cmake 构建系统（编译/安装本包所需） -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- 构建期依赖：gazebo_dev（编译 Gazebo 插件需要的头文件与开发库） -->
  <build_depend>gazebo_dev</build_depend>
  <!-- 构建期依赖：builtin_interfaces（内置消息接口，Time、Duration 等） -->
  <build_depend>builtin_interfaces</build_depend>
  <!-- 构建期依赖：geometry_msgs（几何消息，Point、Pose、Twist 等） -->
  <build_depend>geometry_msgs</build_depend>
  <!-- 构建期依赖：nav_msgs（导航消息，Odometry、OccupancyGrid 等） -->
  <build_depend>nav_msgs</build_depend>
  <!-- 构建期依赖：rclcpp（ROS2 C++ 客户端库，编写节点/插件必需） -->
  <build_depend>rclcpp</build_depend>
  <!-- 构建期依赖：sensor_msgs（传感器消息，LaserScan、PointCloud2 等） -->
  <build_depend>sensor_msgs</build_depend>
  <!-- 构建期依赖：tf2_ros（TF2 坐标变换库） -->
  <build_depend>tf2_ros</build_depend>
  <!-- 运行期依赖：launch（Python launch 框架，运行 launch 文件必需） -->
  <exec_depend>launch</exec_depend>
  <!-- 运行期依赖：launch_ros（ROS2 节点 launch 动作 Node 等） -->
  <exec_depend>launch_ros</exec_depend>
  <!-- 运行期依赖：ament_index_python（get_package_share_directory 等包查询接口） -->
  <exec_depend>ament_index_python</exec_depend>
  <!-- 运行期依赖：gazebo_ros（gzserver/gzclient 的 ROS 插件及 spawn_entity 脚本） -->
  <exec_depend>gazebo_ros</exec_depend>
  <!-- 运行期依赖：gazebo_plugins（常用 Gazebo 传感器/驱动插件） -->
  <exec_depend>gazebo_plugins</exec_depend>
  <!-- 运行期依赖：nav2_bringup（Nav2 导航栈整体 bringup launch） -->
  <exec_depend>nav2_bringup</exec_depend>
  <!-- 运行期依赖：nav2_costmap_2d（代价地图，PCD→costmap 验证链路使用） -->
  <exec_depend>nav2_costmap_2d</exec_depend>
  <!-- 运行期依赖：nav2_map_server（地图服务：加载/保存地图） -->
  <exec_depend>nav2_map_server</exec_depend>
  <!-- 运行期依赖：nav2_planner（全局路径规划器 planner_server） -->
  <exec_depend>nav2_planner</exec_depend>
  <!-- 运行期依赖：nav2_lifecycle_manager（Nav2 生命周期节点统一管理） -->
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <!-- 运行期依赖：pointcloud_to_laserscan（点云转 2D 激光扫描节点） -->
  <exec_depend>pointcloud_to_laserscan</exec_depend>
  <!-- 运行期依赖：pcl_ros（PCL 点云处理相关 ROS2 工具） -->
  <exec_depend>pcl_ros</exec_depend>
  <!-- 运行期依赖：rosbag2_transport（rosbag2 数据包回放/传输支持） -->
  <exec_depend>rosbag2_transport</exec_depend>
  <!-- 运行期依赖：robot_state_publisher（根据 URDF 发布机器人 TF） -->
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- 运行期依赖：rviz2（可视化工具） -->
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>  <!-- 构建类型：ament_cmake -->
  </export>
</package>

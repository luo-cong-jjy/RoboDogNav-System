#!/usr/bin/env python3
# =============================================================================
# lifecycle_configure_activate
# 所属模块：m20_nav2_system / scripts/pcd（点云导航工具链）
# 职责：把目标 ROS2 生命周期节点（LifecycleNode）从 unconfigured 状态推进到
#       active 状态：unconfigured -> configure -> inactive -> activate。
#       典型用法：启动 /costmap/costmap 等 Nav2 生命周期节点后调用本脚本，
#       等待其服务上线并完成 configure/activate 两步状态切换。
# 参数（ROS2 参数）：
#   target_node            目标节点名（默认 "/costmap/costmap"）
#   service_timeout_sec    等待服务上线的超时（秒）
#   transition_timeout_sec 状态切换调用的超时（秒）
#   activate_delay_sec     configure 与 activate 之间的延迟（秒）
# =============================================================================

import sys          # 用于失败时以非零退出码退出（sys.exit(1)）
import time         # 用于计算超时截止时间与 sleep 延迟

import rclpy        # ROS2 Python 客户端库
from lifecycle_msgs.msg import State, Transition   # 生命周期状态/转移消息类型
from lifecycle_msgs.srv import ChangeState, GetState  # 生命周期服务：切换状态/查询状态
from rclpy.node import Node        # ROS2 节点基类


class LifecycleActivator(Node):
    """生命周期节点激活器：负责把目标节点配置并激活。"""

    def __init__(self):
        # 节点名即脚本名，便于在 ros2 node list 中识别
        super().__init__("lifecycle_configure_activate")
        # 声明参数：目标节点名（默认 /costmap/costmap）
        self.declare_parameter("target_node", "/costmap/costmap")
        # 声明参数：等待生命周期服务上线的超时（秒）
        self.declare_parameter("service_timeout_sec", 15.0)
        # 声明参数：状态切换（configure/activate）调用自身的超时（秒）
        self.declare_parameter("transition_timeout_sec", 20.0)
        # 声明参数：configure 完成后、activate 前的延迟（秒），给节点时间完成初始化
        self.declare_parameter("activate_delay_sec", 1.0)

    def service_name(self, suffix):
        """拼接目标节点的服务名：/ns/node + /get_state 或 /change_state。"""
        # 读取目标节点参数（字符串值）
        target_node = self.get_parameter("target_node").get_parameter_value().string_value
        # 去掉结尾 "/" 再拼后缀，避免出现双斜杠（//get_state）
        return target_node.rstrip("/") + suffix

    def get_state(self):
        """调用目标节点的 /get_state 服务，返回当前生命周期状态 id。"""
        # 目标节点的状态查询服务名：/xxx/get_state
        service_name = self.service_name("/get_state")
        # 读取服务等待超时参数（double 值）
        service_timeout = (
            self.get_parameter("service_timeout_sec").get_parameter_value().double_value
        )
        # 读取切换超时参数（double 值）
        transition_timeout = (
            self.get_parameter("transition_timeout_sec").get_parameter_value().double_value
        )

        # 创建 GetState 服务客户端并等待服务上线
        client = self.create_client(GetState, service_name)
        self.get_logger().info(f"waiting for {service_name}")
        # 若在超时时间内服务未上线，报错返回 None
        if not client.wait_for_service(timeout_sec=service_timeout):
            self.get_logger().error(f"service not available: {service_name}")
            return None

        # 异步调用 get_state，并在循环里 spin_once 等待结果或超时
        future = client.call_async(GetState.Request())
        deadline = time.monotonic() + transition_timeout
        while rclpy.ok() and not future.done() and time.monotonic() < deadline:
            rclpy.spin_once(self, timeout_sec=0.1)   # 非阻塞式旋转，驱动回调执行

        # 超时或结果为空则报错
        if not future.done() or future.result() is None:
            self.get_logger().error("get_state timeout")
            return None

        # 取出当前状态并打印标签与 id，返回状态 id
        state = future.result().current_state
        self.get_logger().info(f"current state: {state.label} ({state.id})")
        return state.id

    def call_transition(self, transition_id, label):
        """调用目标节点的 /change_state 服务执行一次状态转移。"""
        # 目标节点的状态切换服务名：/xxx/change_state
        service_name = self.service_name("/change_state")
        # 读取服务等待超时参数
        service_timeout = (
            self.get_parameter("service_timeout_sec").get_parameter_value().double_value
        )
        # 读取切换超时参数
        transition_timeout = (
            self.get_parameter("transition_timeout_sec").get_parameter_value().double_value
        )

        # 创建 ChangeState 服务客户端并等待服务上线
        client = self.create_client(ChangeState, service_name)
        self.get_logger().info(f"waiting for {service_name}")
        if not client.wait_for_service(timeout_sec=service_timeout):
            self.get_logger().error(f"service not available: {service_name}")
            return False

        # 构造转移请求：指定转移 id（如 CONFIGURE/ACTIVATE）与标签
        request = ChangeState.Request()
        request.transition.id = transition_id
        request.transition.label = label
        future = client.call_async(request)
        deadline = time.monotonic() + transition_timeout
        # 同 get_state：spin_once 轮询直到结果返回或超时
        while rclpy.ok() and not future.done() and time.monotonic() < deadline:
            rclpy.spin_once(self, timeout_sec=0.1)

        # 超时未返回结果
        if not future.done():
            self.get_logger().error(f"transition timeout: {label}")
            return False

        # 检查服务响应：success 标志为 false 表示转移被拒绝
        response = future.result()
        if response is None or not response.success:
            self.get_logger().error(f"transition failed: {label}")
            return False

        self.get_logger().info(f"transition succeeded: {label}")
        return True


def main():
    """主入口：按生命周期状态机推进目标节点到 active。"""
    rclpy.init()                     # 初始化 ROS2 客户端库
    node = LifecycleActivator()      # 创建激活器节点
    try:
        # 第一步：查询目标节点当前状态
        state_id = node.get_state()
        # 已经是 active 则无需任何操作
        if state_id == State.PRIMARY_STATE_ACTIVE:
            node.get_logger().info("target node is already active")
            return

        # 若是 unconfigured（或查询失败 None），先执行 configure 转移
        if state_id in (None, State.PRIMARY_STATE_UNCONFIGURED):
            if not node.call_transition(Transition.TRANSITION_CONFIGURE, "configure"):
                sys.exit(1)         # configure 失败则退出
            state_id = node.get_state()   # 重新查询状态，应为 inactive

        # configure 后等待一小段延迟，让节点完成内部初始化
        activate_delay = (
            node.get_parameter("activate_delay_sec").get_parameter_value().double_value
        )
        time.sleep(activate_delay)

        # 若状态异常（非 inactive），再查一次确认
        if state_id != State.PRIMARY_STATE_INACTIVE:
            state_id = node.get_state()

        # 若此时已 active（例如节点配置阶段即自动激活），直接返回
        if state_id == State.PRIMARY_STATE_ACTIVE:
            node.get_logger().info("target node is already active")
            return

        # 若 configure 后仍不是 inactive，说明状态机异常，报错退出
        if state_id != State.PRIMARY_STATE_INACTIVE:
            node.get_logger().error(f"target node is not inactive after configure: {state_id}")
            sys.exit(1)

        # 最后一步：执行 activate 转移，使节点进入 active 开始工作
        if not node.call_transition(Transition.TRANSITION_ACTIVATE, "activate"):
            sys.exit(1)
    finally:
        # 无论成功失败都清理：销毁节点并关闭 rclpy
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()

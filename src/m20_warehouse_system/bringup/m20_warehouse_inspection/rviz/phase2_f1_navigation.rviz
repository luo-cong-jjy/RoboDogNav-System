Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 60
      Value: true
    - Alpha: 0.65
      Class: rviz_default_plugins/PointCloud2
      Color: 95; 125; 165
      Color Transformer: FlatColor
      Enabled: true
      Name: Inactive Floor Overview
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: false
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20/visualization/inactive_floors_cloud
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Axis: X
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 192; 191; 188
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Name: SCAN Global Map
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 1
      Size (m): 0.012000000104308128
      Style: Flat Squares
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20/map/active_global_cloud
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: SCAN Sensor Cloud
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.009999999776482582
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /m20/sensing/sensor_cloud
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.35
      Class: rviz_default_plugins/PointCloud2
      Color: 80; 255; 150
      Color Transformer: FlatColor
      Decay Time: 0.3
      Enabled: false
      Name: SCAN Planner Input Cloud (Supplement)
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: false
      Size (Pixels): 4
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /m20/sensing/local_cloud
      Use Fixed Frame: true
      Value: false
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Name: SCAN Occupancy
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.05000000074505806
      Style: Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /m20/navigation/grid_map/occupancy
      Use Fixed Frame: true
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Name: SCAN Inflated Occupancy
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 3
      Size (m): 0.03999999910593033
      Style: Squares
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /m20/navigation/grid_map/occupancy_inflate
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: Official Deep Robotics M20
      Visual Enabled: true
      Value: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 255; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.029999999329447746
      Name: SCAN Robot Path
      Pose Style: None
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20/sim/path
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: SCAN Global Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20/navigation/global_list
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: SCAN Initial Path
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20/navigation/init_list
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: SCAN Rebound AStar
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20/navigation/a_star_list
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: SCAN Optimized Path
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20/navigation/optimal_list
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: M20 Collision Envelope
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20/navigation/self_inflation
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: SCAN Sliding Map Bounds
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20/navigation/grid_map/sliding_map_bbox
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: SCAN Goal
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20/navigation/goal_point
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20/visualization/floor_markers
      Name: Floor Boundaries and State
      Queue Size: 10
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Mission State
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /m20/visualization/mission_marker
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 22; 25; 30
    Fixed Frame: warehouse_overview
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic: /m20/navigation/scan_goal
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 75
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Name: Flat Multi-Floor Navigation
      Near Clip Distance: 0.01
      Pitch: 1.35
      Target Frame: <Fixed Frame>
      Value: Orbit
      Yaw: 1.57
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: true
  Width: 1440
  X: 60
  Y: 40

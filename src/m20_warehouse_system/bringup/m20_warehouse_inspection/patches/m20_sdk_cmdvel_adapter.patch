+}
diff --git a/src/M20_sdk_deploy/extensions/qw_cmd_vel_state_machine.hpp b/src/M20_sdk_deploy/extensions/qw_cmd_vel_state_machine.hpp
new file mode 100644
index 0000000..0b76410
--- /dev/null
+++ b/src/M20_sdk_deploy/extensions/qw_cmd_vel_state_machine.hpp
@@ -0,0 +1,113 @@
+#pragma once
+
+#include "quadruped_wheel/idle_state.hpp"
+#include "quadruped_wheel/joint_damping_state.hpp"
+#include "quadruped_wheel/liedown_state.hpp"
+#include "quadruped_wheel/rl_control_state.hpp"
+#include "quadruped_wheel/standup_state.hpp"
+#include "cmd_vel_interface.hpp"
+#include "hardware/m20_interface.hpp"
+#include "safe_controller.hpp"
+#include "state_machine_base.h"
+
+namespace m20_extensions {
+
+/**
+ * QwCmdVelStateMachine 是面向导航集成的状态机版本。
+ *
+ * 与官方 qw::QwStateMachine 的主要区别：
+ *   - 用户命令来源不是键盘/手柄，而是 CmdVelInterface；
+ *   - CmdVelInterface 订阅 /cmd_vel，适合接 Nav2、Gazebo 导航或上层规划器；
+ *   - 机器人接口、起立/趴下/RL 控制/阻尼状态仍复用官方实现。
+ *
+ * 因此它是“导航速度命令 -> 官方 RL 运控部署”的桥。
+ */
+class QwCmdVelStateMachine : public StateMachineBase {
+public:
+    explicit QwCmdVelStateMachine(RobotName robot_name)
+        : StateMachineBase(RobotType::QuadrupedWheel), robot_name_(robot_name) {}
+
+    ~QwCmdVelStateMachine() override = default;
+
+    void Start() override {
+        // 用户命令接口换成 /cmd_vel 桥接器。
+        uc_ptr_ = std::make_shared<CmdVelInterface>(robot_name_);
+        uc_ptr_->SetMotionStateFeedback(&StateBase::msfb_);
+
+        if (robot_name_ == RobotName::M20) {
+            // 底层接口仍是官方 M20Interface，最终发布 /JOINTS_CMD。
+            ri_ptr_ = std::make_shared<M20Interface>("M20");
+            cp_ptr_ = std::make_shared<ControlParameters>(robot_name_);
+        } else {
+            std::cerr << "QwCmdVelStateMachine only supports M20 now." << std::endl;
+            exit(0);
+        }
+
+        auto data_ptr = std::make_shared<ControllerData>();
+        data_ptr->ri_ptr = ri_ptr_;
+        data_ptr->uc_ptr = uc_ptr_;
+        data_ptr->cp_ptr = cp_ptr_;
+
+        sc_ptr_ = std::make_shared<SafeController>(QuadrupedWheel, "");
+        sc_ptr_->SetRobotDataSource(ri_ptr_);
+        sc_ptr_->SetUserCommandDataSource(uc_ptr_);
+
+        // 状态集合与官方键盘/手柄版本一致：
+        // idle 检查传感器 -> standup 起立 -> rl_control 策略行走 -> liedown 趴下；
+        // joint_damping 是安全/急停状态。
+        idle_controller_ = std::make_shared<qw::IdleState>(robot_name_, "idle_state", data_ptr);
+        standup_controller_ = std::make_shared<qw::StandUpState>(robot_name_, "standup_state", data_ptr);
+        rl_controller_ = std::make_shared<qw::RLControlState>(robot_name_, "rl_control", data_ptr);
+        joint_damping_controller_ = std::make_shared<qw::JointDampingState>(robot_name_, "joint_damping", data_ptr);
+        liedown_controller_ = std::make_shared<qw::LieDownState>(robot_name_, "liedown_state", data_ptr);
+
+        current_controller_ = idle_controller_;
+        current_state_name_ = kIdle;
+        next_state_name_ = kIdle;
+
+        // 启动顺序很重要：先启动机器人接口和命令接口，再启动安全控制器，最后进入当前状态。
+        ri_ptr_->Start();
+        uc_ptr_->Start();
+        sc_ptr_->Start();
+        current_controller_->OnEnter();
+    }
+
+    std::shared_ptr<StateBase> GetStateControllerPtr(StateName state_name) override {
+        // 状态机基类只保存 StateName，这里负责把枚举映射回具体状态对象。
+        switch (state_name) {
+            case StateName::kInvalid:
+                return nullptr;
+            case StateName::kIdle:
+                return idle_controller_;
+            case StateName::kStandUp:
+                return standup_controller_;
+            case StateName::kRLControl:
+                return rl_controller_;
+            case StateName::kJointDamping:
+                return joint_damping_controller_;
+            case StateName::kLieDown:
+                return liedown_controller_;
+            default:
+                std::cerr << "error state name" << std::endl;
+                return joint_damping_controller_;
+        }
+    }
+
+    void Stop() override {
+        if (current_controller_) current_controller_->OnExit();
+        if (sc_ptr_) sc_ptr_->Stop();
+        if (uc_ptr_) uc_ptr_->Stop();
+        if (ri_ptr_) ri_ptr_->Stop();
+    }
+
+private:
+    const RobotName robot_name_;
+
+    std::shared_ptr<StateBase> idle_controller_;
+    std::shared_ptr<StateBase> standup_controller_;
+    std::shared_ptr<StateBase> rl_controller_;
+    std::shared_ptr<StateBase> joint_damping_controller_;
+    std::shared_ptr<StateBase> liedown_controller_;
+};
+
+}  // namespace m20_extensions

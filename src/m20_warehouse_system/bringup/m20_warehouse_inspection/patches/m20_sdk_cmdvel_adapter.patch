diff --git a/src/M20_sdk_deploy/extensions/cmd_vel_interface.hpp b/src/M20_sdk_deploy/extensions/cmd_vel_interface.hpp
new file mode 100644
index 0000000..907e53b
--- /dev/null
+++ b/src/M20_sdk_deploy/extensions/cmd_vel_interface.hpp
@@ -0,0 +1,259 @@
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#include "geometry_msgs/msg/twist.hpp"
+#include "rclcpp/rclcpp.hpp"
+#include "user_command_interface.h"
+
+using namespace interface;
+using namespace types;
+
+namespace m20_extensions {
+
+/**
+ * CmdVelInterface 把 ROS 标准 /cmd_vel 转换成 SDK 内部 UserCommand。
+ *
+ * 用途：
+ *   - 导航栈/Nav2 通常输出 geometry_msgs::msg::Twist；
+ *   - 官方 RL 策略需要的是 UserCommand.forward/side/yaw；
+ *   - 这个类就在两者之间做桥接。
+ *
+ * 它只处理“用户命令”，不直接控制关节。真正的关节命令仍由
+ * RLControlState -> M20PolicyRunner -> RobotInterface 生成和下发。
+ */
+class CmdVelInterface : public UserCommandInterface {
+public:
+    explicit CmdVelInterface(RobotName robot_name) : UserCommandInterface(robot_name) {
+        node_ = std::make_shared<rclcpp::Node>("m20_cmd_vel_interface");
+
+        // 参数都可以在 launch/ros2 param 中覆盖，便于和不同导航栈对接。
+        cmd_vel_topic_ = node_->declare_parameter<std::string>("cmd_vel_topic", "/cmd_vel");
+        auto_start_ = node_->declare_parameter<bool>("auto_start", true);
+        standup_delay_sec_ = node_->declare_parameter<double>("standup_delay_sec", 3.3);
+        cmd_timeout_sec_ = node_->declare_parameter<double>("cmd_timeout_sec", 0.5);
+        max_forward_ = node_->declare_parameter<double>("max_forward", 0.7);
+        max_side_ = node_->declare_parameter<double>("max_side", 0.5);
+        max_yaw_ = node_->declare_parameter<double>("max_yaw", 0.7);
+        control_rate_hz_ = node_->declare_parameter<double>("control_rate_hz", 50.0);
+        debug_print_ = node_->declare_parameter<bool>("debug_print", true);
+
+        cmd_sub_ = node_->create_subscription<geometry_msgs::msg::Twist>(
+            cmd_vel_topic_, 10, [this](const geometry_msgs::msg::Twist::SharedPtr msg) {
+                std::lock_guard<std::mutex> lock(cmd_mutex_);
+
+                // Twist 的线速度 x/y 和角速度 z 分别映射到策略的三维 command。
+                // Clamp 是保护层，防止导航栈输出超过策略训练范围太多。
+                desired_forward_ = Clamp(msg->linear.x, -max_forward_, max_forward_);
+                desired_side_ = Clamp(msg->linear.y, -max_side_, max_side_);
+                desired_yaw_ = Clamp(msg->angular.z, -max_yaw_, max_yaw_);
+                last_cmd_time_ = Clock::now();
+                has_cmd_ = true;
+            });
+
+        std::cout << "[CmdVelInterface] topic=" << cmd_vel_topic_
+                  << " auto_start=" << std::boolalpha << auto_start_
+                  << " timeout=" << cmd_timeout_sec_ << "s"
+                  << " limits(fwd/side/yaw)=" << max_forward_ << "/"
+                  << max_side_ << "/" << max_yaw_
+                  << " debug_print=" << debug_print_ << std::endl;
+    }
+
+    ~CmdVelInterface() override { Stop(); }
+
+    void Start() override {
+        if (running_) return;
+        running_ = true;
+        start_time_ = Clock::now();
+        standing_state_start_time_ = start_time_;
+        last_cmd_time_ = Clock::now();
+        last_debug_print_time_ = Clock::now();
+
+        executor_ = std::make_shared<rclcpp::executors::SingleThreadedExecutor>();
+        executor_->add_node(node_);
+
+        // 一个线程专门 spin ROS，另一个线程固定频率更新 UserCommand。
+        spin_thread_ = std::thread([this]() {
+            executor_->spin();
+        });
+        control_thread_ = std::thread(&CmdVelInterface::ControlLoop, this);
+    }
+
+    void Stop() override {
+        if (!running_) return;
+        running_ = false;
+
+        {
+            std::lock_guard<std::mutex> lock(cmd_mutex_);
+            // 停止时清空速度，避免退出前保留最后一次导航速度。
+            desired_forward_ = 0.0;
+            desired_side_ = 0.0;
+            desired_yaw_ = 0.0;
+        }
+
+        usr_cmd_->forward_vel_scale = 0.0f;
+        usr_cmd_->side_vel_scale = 0.0f;
+        usr_cmd_->turnning_vel_scale = 0.0f;
+
+        if (executor_) {
+            executor_->cancel();
+        }
+        if (control_thread_.joinable()) {
+            control_thread_.join();
+        }
+        if (spin_thread_.joinable()) {
+            spin_thread_.join();
+        }
+        if (executor_) {
+            executor_->remove_node(node_);
+            executor_.reset();
+        }
+    }
+
+    UserCommand* GetUserCommand() override { return usr_cmd_; }
+
+private:
+    using Clock = std::chrono::steady_clock;
+
+    static double Clamp(double value, double low, double high) {
+        return std::max(low, std::min(value, high));
+    }
+
+    static double ElapsedSec(const Clock::time_point& from, const Clock::time_point& to) {
+        return std::chrono::duration<double>(to - from).count();
+    }
+
+    static double NowMs() {
+        return std::chrono::duration<double, std::milli>(Clock::now().time_since_epoch()).count();
+    }
+
+    void ControlLoop() {
+        const double safe_rate = std::max(1.0, control_rate_hz_);
+        const auto period = std::chrono::duration<double>(1.0 / safe_rate);
+        auto next_wakeup = Clock::now();
+
+        while (running_) {
+            const auto now = Clock::now();
+            usr_cmd_->time_stamp = NowMs();
+
+            // 先更新目标状态，再根据当前状态决定速度命令是否允许输出。
+            UpdateMode(now);
+            UpdateVelocity(now);
+
+            next_wakeup += std::chrono::duration_cast<Clock::duration>(period);
+            std::this_thread::sleep_until(next_wakeup);
+        }
+    }
+
+    void UpdateMode(const Clock::time_point& now) {
+        if (!auto_start_) return;
+
+        // auto_start=true 时，这个接口会自动推进：
+        // Waiting/LieDown -> StandingUp -> RLControlMode。
+        // 这样导航启动后无需手动按键，但仍尊重 JointDamping 安全状态。
+        const uint8_t state = msfb_ ? msfb_->GetCurrentState() : uint8_t(RobotMotionState::WaitingForStand);
+
+        if (state != last_state_for_mode_) {
+            if (state == uint8_t(RobotMotionState::StandingUp)) {
+                standing_state_start_time_ = now;
+            }
+            last_state_for_mode_ = state;
+        }
+
+        if (state == uint8_t(RobotMotionState::JointDamping)) {
+            usr_cmd_->target_mode = uint8_t(RobotMotionState::JointDamping);
+            return;
+        }
+
+        if (state == uint8_t(RobotMotionState::WaitingForStand) ||
+            state == uint8_t(RobotMotionState::LieDown)) {
+            usr_cmd_->target_mode = uint8_t(RobotMotionState::StandingUp);
+            return;
+        }
+
+        if (state == uint8_t(RobotMotionState::StandingUp) &&
+            ElapsedSec(standing_state_start_time_, now) < standup_delay_sec_) {
+            usr_cmd_->target_mode = uint8_t(RobotMotionState::StandingUp);
+        } else {
+            usr_cmd_->target_mode = uint8_t(RobotMotionState::RLControlMode);
+        }
+    }
+
+    void UpdateVelocity(const Clock::time_point& now) {
+        double fwd = 0.0;
+        double side = 0.0;
+        double yaw = 0.0;
+        bool fresh_cmd = false;
+        const uint8_t state = msfb_ ? msfb_->GetCurrentState() : uint8_t(RobotMotionState::WaitingForStand);
+
+        {
+            std::lock_guard<std::mutex> lock(cmd_mutex_);
+            // 超过 cmd_timeout_sec 没收到 /cmd_vel，就认为命令失效并输出 0 速度。
+            fresh_cmd = has_cmd_ && ElapsedSec(last_cmd_time_, now) <= cmd_timeout_sec_;
+
+            // 只有真的处于 RLControlMode 时才把速度交给策略；
+            // 起立、趴下、阻尼等状态下速度保持 0。
+            if (fresh_cmd && state == uint8_t(RobotMotionState::RLControlMode)) {
+                fwd = desired_forward_;
+                side = desired_side_;
+                yaw = desired_yaw_;
+            }
+        }
+
+        usr_cmd_->forward_vel_scale = static_cast<float>(fwd);
+        usr_cmd_->side_vel_scale = static_cast<float>(side);
+        usr_cmd_->turnning_vel_scale = static_cast<float>(yaw);
+
+        DebugPrint(now, state, fresh_cmd, fwd, side, yaw);
+    }
+
+    void DebugPrint(const Clock::time_point& now, uint8_t state, bool fresh_cmd,
+                    double fwd, double side, double yaw) {
+        if (!debug_print_) return;
+        if (ElapsedSec(last_debug_print_time_, now) < 1.0) return;
+        last_debug_print_time_ = now;
+
+        std::cout << "[CmdVelInterface] state=" << int(state)
+                  << " target_mode=" << int(usr_cmd_->target_mode)
+                  << " fresh_cmd=" << std::boolalpha << fresh_cmd
+                  << " output(fwd/side/yaw)=" << fwd << "/"
+                  << side << "/" << yaw << std::endl;
+    }
+
+    rclcpp::Node::SharedPtr node_;
+    rclcpp::Subscription<geometry_msgs::msg::Twist>::SharedPtr cmd_sub_;
+    std::shared_ptr<rclcpp::executors::SingleThreadedExecutor> executor_;
+
+    std::atomic<bool> running_{false};
+    std::thread spin_thread_;
+    std::thread control_thread_;
+    std::mutex cmd_mutex_;
+
+    std::string cmd_vel_topic_;
+    bool auto_start_ = true;
+    double standup_delay_sec_ = 3.3;
+    double cmd_timeout_sec_ = 0.5;
+    double max_forward_ = 0.7;
+    double max_side_ = 0.5;
+    double max_yaw_ = 0.7;
+    double control_rate_hz_ = 50.0;
+    bool debug_print_ = true;
+
+    Clock::time_point start_time_;
+    Clock::time_point standing_state_start_time_;
+    Clock::time_point last_cmd_time_;
+    Clock::time_point last_debug_print_time_;
+    uint8_t last_state_for_mode_ = uint8_t(RobotMotionState::WaitingForStand);
+    bool has_cmd_ = false;
+    double desired_forward_ = 0.0;
+    double desired_side_ = 0.0;
+    double desired_yaw_ = 0.0;
+};
+
+}  // namespace m20_extensions

+#include "qw_cmd_vel_state_machine.hpp"
+
+MotionStateFeedback StateBase::msfb_ = MotionStateFeedback();
+
+int main(int argc, char** argv) {
+    rclcpp::init(argc, argv);
+
+    // 面向导航集成的入口：
+    //   Nav2/Gazebo/上层规划器 -> /cmd_vel
+    //   CmdVelInterface -> UserCommand
+    //   官方 M20 RL 策略 -> /JOINTS_CMD
+    //
+    // 和 main.cpp 的键盘版本相比，这里只替换“用户命令来源”，
+    // 底层 M20Interface、状态机状态和 policy.onnx 都继续复用。
+    auto fsm = std::make_shared<m20_extensions::QwCmdVelStateMachine>(RobotName::M20);
+
+    fsm->Start();
+    fsm->Run();
+    fsm->Stop();
+
+    if (rclcpp::ok()) {
+        rclcpp::shutdown();
+    }

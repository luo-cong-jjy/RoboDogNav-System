<!-- ============================================================
     文件：m20_robot.xml
     用途：M20 机器人 MuJoCo（MJCF）模型模板。
           - 描述完整机身（base_link，自由关节 floating_base）与
             四条腿（fl/fr/hl/hr × 髋横滚 hipx / 髋俯仰 hipy / 膝 knee /
             轮 wheel），外观使用 m20_official_description 的 STL 网格，
             碰撞体为简化圆柱/盒体；
           - 默认类：visual（纯外观，contype=0 不参与碰撞）与
             collision（参与碰撞，condim=3、低摩擦、soft 求解器）；
           - <actuator> 提供 16 个电机（腿 76.4N·m、轮 21.6N·m 限幅），
             与 dynamics.py 的 JOINT_NAMES 顺序一一对应；
           - <contact> 排除相邻连杆之间的接触，避免自身碰撞干扰；
           - <sensor> 提供机体系四元数/加速度计/陀螺仪（imu_site），
             供后端发布 SDK 风格 IMU 数据；
           - 本模板会被 world_generator 复制并注入仓库障碍物/围墙，
             同时覆盖 compiler/option 物理参数。
     ============================================================ -->
<mujoco model="M20">

    <!-- ==================== 默认类（default class） ==================== -->
    <default>
        <default class="robot">
            <!-- motor 子类：所有电机默认空 joint/motor（由 actuator 段填写）。 -->
            <default class="motor">
                <joint/>
                <motor/>
            </default>
            <!-- visual 子类：外观几何，contype/conaffinity=0 不参与碰撞，
                 渲染分组 group=2（与碰撞体分开显示）。 -->
            <default class="visual">
                <geom material="default_material" contype="0" conaffinity="0" group="2"/>
            </default>
            <!-- collision 子类：碰撞几何，condim=3（摩擦锥）、
                 contype/conaffinity=1（与障碍物碰撞）、soft 求解器
                 solref="0.005 1"、低摩擦 friction="1 0.01 0.001"、
                 density=0（质量全由 inertial 决定）。 -->
            <default class="collision">
                <geom material="collision_material" condim="3" contype="1" conaffinity="1" solref="0.005 1"
                      friction="1 0.01 0.001" density="0" group="1"/>
                <!--                <equality solimp="0.99 0.999 1e-05" solref="0.005 1"/>-->
            </default>
        </default>
    </default>

    <!-- ==================== 编译器选项 ==================== -->
    <!-- 角度单位弧度；meshdir 指向网格目录（world_generator 会覆盖为
         描述包 meshes 目录）；autolimits 开启自动限位。 -->
    <compiler angle="radian" meshdir="../meshes/"/>
    <compiler autolimits="true"/>

    <!-- ==================== 资源（网格 / 材质 / 纹理） ==================== -->
    <asset>
        <!-- 外观与碰撞材质（碰撞材质半透明便于调试）。 -->
        <material name="default_material" rgba="0.7 0.7 0.7 1"/>
        <material name="collision_material" rgba="0.0 0.4 0.8 0.2"/>
        <!-- 17 个 STL 网格：机身 + 16 个连杆（每条腿 4 个部件）。 -->
        <mesh name="base_link" file="base_link.STL"/>
        <mesh name="fl_hipx" file="fl_hipx.STL"/>
        <mesh name="fl_hipy" file="fl_hipy.STL"/>
        <mesh name="fl_knee" file="fl_knee.STL"/>
        <mesh name="fl_wheel" file="fl_wheel.STL"/>
        <mesh name="fr_hipx" file="fr_hipx.STL"/>
        <mesh name="fr_hipy" file="fr_hipy.STL"/>
        <mesh name="fr_knee" file="fr_knee.STL"/>
        <mesh name="fr_wheel" file="fr_wheel.STL"/>
        <mesh name="hl_hipx" file="hl_hipx.STL"/>
        <mesh name="hl_hipy" file="hl_hipy.STL"/>
        <mesh name="hl_knee" file="hl_knee.STL"/>
        <mesh name="hl_wheel" file="hl_wheel.STL"/>
        <mesh name="hr_hipx" file="hr_hipx.STL"/>
        <mesh name="hr_hipy" file="hr_hipy.STL"/>
        <mesh name="hr_knee" file="hr_knee.STL"/>
        <mesh name="hr_wheel" file="hr_wheel.STL"/>
        <!-- 地面棋盘纹理与材质。 -->
        <texture name="texplane" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 0.15 0.2"
                 width="512" height="512"/>
        <!--        <material name='geom' texture="texgeom" texuniform="true"/>-->
        <material name='MatPlane' reflectance='0.3' texture="texplane" texrepeat="1 1" texuniform="true"/>
    </asset>

    <!-- ==================== 世界体（worldbody） ==================== -->
    <worldbody>
        <!-- 灯光 -->
        <!-- 方向光：从 (-0.5, 0.5, 3) 竖直向下照射，保证场景亮度。 -->
        <light directional="true" pos="-0.5 0.5 3" dir="0 0 -1"/>
        <!--        <geom name="floor" pos="0 0 0" rgba="0.8 0.9 0.8 1" size="40 40 40" type="plane"/>-->
        <!-- 地面：大平面 geom（100×100），world_generator 会将其重命名为
             warehouse_ground 并覆盖接触参数。 -->
        <geom name='floor' pos='0 0 0' size='100 100 .125' type='plane' material="MatPlane" condim='3'
              friction="1 0.01 0.01" group="0"/>

        <!-- ==================== base_link：机身（带浮动自由关节） ==================== -->
        <!-- 自由关节 floating_base：6 自由度（x/y/z + 四元数），
             qpos 布局为 [x, y, z, quat(wxyz), 16 关节角]；
             惯性参数与官方 URDF 一致。 -->
        <body name="base_link" pos="0 0. 1." quat="1 0 0 0" childclass="robot">
            <freejoint name="floating_base"/>
            <inertial pos="0.00355105878308153 0.0016507579200937 -0.00346462146571654"
                      quat="1 0 0 0"
                      mass="15.882" diaginertia="0.087919 0.533522 0.563492"/>

            <!-- imu_site：IMU 安装点（传感器挂点）；base_site：机身原点挂点。 -->
            <site name="imu_site" pos="0.0632 -0.0268 0.0435" size="0.005" rgba="1 0 0 1"/>
            <site name="base_site" pos="0 0 0" quat="1 0 0 0"/>

            <!-- 机身外观（STL 网格）与 3 个简化碰撞体（主体盒 + 两侧圆柱）。 -->
            <geom type="mesh" mesh="base_link" class="visual"/>
            <geom size="0.375 0.045 0.07" type="box" class="collision"/>
            <geom size="0.07 0.375" pos="0 0.045 0" quat="0.707107 0 0.707107 0" type="cylinder" class="collision"/>
            <geom size="0.07 0.375" pos="0 -0.045 0" quat="0.707107 0 0.707107 0" type="cylinder" class="collision"/>

            <!-- ==================== fl_hipx：左前髋横滚 ==================== -->
            <!-- 关节绕 X 轴（axis="-1 0 0"），range 与官方 URDF 限位一致，
                 执行器力矩范围 ±76.4 N·m。 -->
            <body name="fl_hipx" pos="0.3141 0.0685 0">
                <inertial pos="-0.0111893 0.00891693 0.000405666" quat="0.581628 0.481707 0.465607 0.461387"
                          mass="0.259964"
                          diaginertia="0.000374402 0.000286289 0.000179309"/>
                <joint name="fl_hipx_joint" pos="0 0 0" axis="-1 0 0" range="-0.436 0.611"
                       actuatorfrcrange="-76.4 76.4"/>
                <geom type="mesh" mesh="fl_hipx" class="visual"/>
                <geom size="0.048 0.07" pos="0 0.055 0" quat="0.707107 0.707107 0 0" type="cylinder" class="collision"/>
                <!-- ==================== fl_hipy：左前髋俯仰 ==================== -->
                <!-- 关节绕 Y 轴（axis="0 -1 0"），主驱动摆腿关节。 -->
                <body name="fl_hipy">
                    <inertial pos="-0.00199375 0.098439 -0.130664" quat="0.6754 -0.0565887 0.0622156 0.73264"
                              mass="2.618"
                              diaginertia="0.0410181 0.0408067 0.00297328"/>
                    <joint name="fl_hipy_joint" pos="0 0 0" axis="0 -1 0" range="-2.286 2.583"
                           actuatorfrcrange="-76.4 76.4"/>
                    <geom type="mesh" mesh="fl_hipy" class="visual"/>
                    <geom size="0.035 0.01 0.125" pos="-0.01 0.11 -0.125" type="box" class="collision"/>
                    <geom size="0.05 0.045" pos="0 0.11 -0.25" quat="0.707107 0.707107 0 0" type="cylinder"
                          class="collision"/>
                    <!-- ==================== fl_knee：左前膝 ==================== -->
                    <!-- 膝关节，绕 Y 轴，配合髋俯仰完成腿部弯曲。 -->
                    <body name="fl_knee" pos="0 0.0984 -0.25">
                        <inertial pos="0.00341917 0.00269124 -0.181265" quat="0.633405 -0.0508555 0.0475887 0.77068"
                                  mass="1.145" diaginertia="0.0121304 0.0117245 0.000948105"/>
                        <joint name="fl_knee_joint" pos="0 0 0" axis="0 -1 0" range="-2.809 2.792"
                               actuatorfrcrange="-76.4 76.4"/>
                        <geom type="mesh" mesh="fl_knee" class="visual"/>
                        <geom size="0.03 0.0125 0.125" pos="0.015 -0.015 -0.125" type="box" class="collision"/>
                        <geom size="0.04 0.05" pos="0 0.02 -0.25" quat="0.707107 0.707107 0 0" type="cylinder"
                              class="collision"/>
                        <!-- ==================== fl_wheel：左前轮 ==================== -->
                        <!-- 末端轮：无 range（连续旋转），力矩限幅 ±21.6 N·m。 -->
                        <body name="fl_wheel" pos="0 0.059676 -0.25">
                            <inertial pos="-3.11398e-07 0.000279002 5.70329e-07" quat="0.707107 0 0 0.707107"
                                      mass="0.638"
                                      diaginertia="0.002853 0.001535 0.001535"/>
                            <joint name="fl_wheel_joint" pos="0 0 0" axis="0 -1 0" actuatorfrcrange="-21.6 21.6"/>
                            <geom type="mesh" mesh="fl_wheel" class="visual"/>
                            <geom size="0.09 0.027" quat="0.707107 0.707107 0 0" type="cylinder" class="collision"/>
                        </body>
                    </body>
                </body>
            </body>
            <!-- ==================== fr_hipx：右前髋横滚 ==================== -->
            <body name="fr_hipx" pos="0.3141 -0.0685 0">
                <inertial pos="-0.0110901 -0.00875035 0.000521421" quat="0.461387 0.465607 0.481707 0.581628"
                          mass="0.259964" diaginertia="0.000374402 0.000286289 0.000179309"/>
                <joint name="fr_hipx_joint" pos="0 0 0" axis="-1 0 0" range="-0.611 0.436"
                       actuatorfrcrange="-76.4 76.4"/>
                <geom type="mesh" mesh="fr_hipx" class="visual"/>
                <geom size="0.048 0.07" pos="0 -0.055 0" quat="0.707107 0.707107 0 0" type="cylinder"
                      class="collision"/>
                <!-- ==================== fr_hipy：右前髋俯仰 ==================== -->
                <body name="fr_hipy">
                    <inertial pos="-0.00229992 -0.0989709 -0.130925" quat="0.6964 0.0586688 -0.0587886 0.712831"
                              mass="2.618" diaginertia="0.0407542 0.040538 0.00301281"/>
                    <joint name="fr_hipy_joint" pos="0 0 0" axis="0 -1 0" range="-2.286 2.583"
                           actuatorfrcrange="-76.4 76.4"/>
                    <geom type="mesh" mesh="fr_hipy" class="visual"/>
                    <geom size="0.035 0.01 0.125" pos="-0.01 -0.11 -0.125" type="box" class="collision"/>
                    <geom size="0.05 0.045" pos="0 -0.11 -0.25" quat="0.707107 0.707107 0 0" type="cylinder"
                          class="collision"/>
                    <!-- ==================== fr_knee：右前膝 ==================== -->
                    <body name="fr_knee" pos="0 -0.0984 -0.25">
                        <inertial pos="0.00354945 -0.00247884 -0.180089" quat="0.769194 0.0472982 -0.0504711 0.635261"
                                  mass="1.145" diaginertia="0.0122564 0.0118448 0.000951718"/>
                        <joint name="fr_knee_joint" pos="0 0 0" axis="0 -1 0" range="-2.809 2.792"
                               actuatorfrcrange="-76.4 76.4"/>
                        <geom type="mesh" mesh="fr_knee" class="visual"/>
                        <geom size="0.03 0.0125 0.125" pos="0.015 0.015 -0.125" type="box" class="collision"/>
                        <geom size="0.04 0.05" pos="0 -0.02 -0.25" quat="0.707107 0.707107 0 0" type="cylinder"
                              class="collision"/>
                        <!-- ==================== fr_wheel：右前轮 ==================== -->
                        <body name="fr_wheel" pos="0 -0.059676 -0.25">
                            <inertial pos="-6.47327e-07 -0.000279012 -4.6242e-08" quat="0.707107 0 0 0.707107"
                                      mass="0.638"
                                      diaginertia="0.002853 0.001535 0.001535"/>
                            <joint name="fr_wheel_joint" pos="0 0 0" axis="0 -1 0" actuatorfrcrange="-21.6 21.6"/>
                            <geom type="mesh" mesh="fr_wheel" class="visual"/>
                            <geom size="0.09 0.027" quat="0.707107 0.707107 0 0" type="cylinder" class="collision"/>
                        </body>
                    </body>
                </body>
            </body>
            <!-- ==================== hl_hipx：左后髋横滚 ==================== -->
            <body name="hl_hipx" pos="-0.3141 0.0685 0">
                <inertial pos="0.0110901 0.00875014 0.000524884" quat="0.465607 0.461387 0.581628 0.481707"
                          mass="0.259964"
                          diaginertia="0.000374402 0.000286289 0.000179309"/>
                <joint name="hl_hipx_joint" pos="0 0 0" axis="-1 0 0" range="-0.436 0.611"
                       actuatorfrcrange="-76.4 76.4"/>
                <geom type="mesh" mesh="hl_hipx" class="visual"/>
                <geom size="0.048 0.07" pos="0 0.055 0" quat="0.707107 0.707107 0 0" type="cylinder" class="collision"/>
                <!-- ==================== hl_hipy：左后髋俯仰 ==================== -->
                <body name="hl_hipy">
                    <inertial pos="0.00204343 0.0990227 -0.130697" quat="0.750359 -0.0628584 0.0546506 0.655761"
                              mass="2.618" diaginertia="0.0408376 0.0406211 0.00299727"/>
                    <joint name="hl_hipy_joint" pos="0 0 0" axis="0 -1 0" range="-2.583 2.286"
                           actuatorfrcrange="-76.4 76.4"/>
                    <geom type="mesh" mesh="hl_hipy" class="visual"/>
                    <geom size="0.035 0.01 0.125" pos="0.01 0.11 -0.125" type="box" class="collision"/>
                    <geom size="0.05 0.045" pos="0 0.11 -0.25" quat="0.707107 0.707107 0 0" type="cylinder"
                          class="collision"/>
                    <!-- ==================== hl_knee：左后膝 ==================== -->
                    <body name="hl_knee" pos="0 0.0984 -0.25">
                        <inertial pos="-0.00354945 0.00247885 -0.180089" quat="0.769194 -0.0472982 0.0504711 0.635261"
                                  mass="1.145" diaginertia="0.0122564 0.0118448 0.000951718"/>
                        <joint name="hl_knee_joint" pos="0 0 0" axis="0 -1 0" range="-2.792 2.809"
                               actuatorfrcrange="-76.4 76.4"/>
                        <geom type="mesh" mesh="hl_knee" class="visual"/>
                        <geom size="0.03 0.0125 0.125" pos="-0.015 0.015 -0.125" type="box" class="collision"/>
                        <geom size="0.04 0.05" pos="0 0.02 -0.25" quat="0.707107 0.707107 0 0" type="cylinder"
                              class="collision"/>
                        <!-- ==================== hl_wheel：左后轮 ==================== -->
                        <body name="hl_wheel" pos="0 0.059676 -0.25">
                            <inertial pos="-6.07889e-07 0.000279009 2.1049e-07" quat="0.707107 0 0 0.707107"
                                      mass="0.638"
                                      diaginertia="0.002853 0.001535 0.001535"/>
                            <joint name="hl_wheel_joint" pos="0 0 0" axis="0 -1 0" actuatorfrcrange="-21.6 21.6"/>
                            <geom type="mesh" mesh="hl_wheel" class="visual"/>
                            <geom size="0.09 0.027" quat="0.707107 0.707107 0 0" type="cylinder" class="collision"/>
                        </body>
                    </body>
                </body>
            </body>
            <!-- ==================== hr_hipx：右后髋横滚 ==================== -->
            <body name="hr_hipx" pos="-0.3141 -0.0685 0">
                <inertial pos="0.0110902 -0.00875012 0.000524937" quat="0.481707 0.581628 0.461387 0.465607"
                          mass="0.259964"
                          diaginertia="0.000374402 0.000286289 0.000179309"/>
                <joint name="hr_hipx_joint" pos="0 0 0" axis="-1 0 0" range="-0.611 0.436"
                       actuatorfrcrange="-76.4 76.4"/>
                <geom type="mesh" mesh="hr_hipx" class="visual"/>
                <geom size="0.048 0.07" pos="0 -0.055 0" quat="0.707107 0.707107 0 0" type="cylinder"
                      class="collision"/>
                <!-- ==================== hr_hipy：右后髋俯仰 ==================== -->
                <body name="hr_hipy">
                    <inertial pos="0.001992 -0.0983704 -0.130561" quat="0.676694 0.0567616 -0.0621797 0.731435"
                              mass="2.618"
                              diaginertia="0.0410109 0.0408028 0.00297526"/>
                    <joint name="hr_hipy_joint" pos="0 0 0" axis="0 -1 0" range="-2.583 2.286"
                           actuatorfrcrange="-76.4 76.4"/>
                    <geom type="mesh" mesh="hr_hipy" class="visual"/>
                    <geom size="0.035 0.01 0.125" pos="0.01 -0.11 -0.125" type="box" class="collision"/>
                    <geom size="0.05 0.045" pos="0 -0.11 -0.25" quat="0.707107 0.707107 0 0" type="cylinder"
                          class="collision"/>
                    <!-- ==================== hr_knee：右后膝 ==================== -->
                    <body name="hr_knee" pos="0 -0.0984 -0.25">
                        <inertial pos="-0.00341053 -0.00270202 -0.181287" quat="0.63448 0.050937 -0.0475303 0.769793"
                                  mass="1.145" diaginertia="0.0121352 0.0117289 0.000948904"/>
                        <joint name="hr_knee_joint" pos="0 0 0" axis="0 -1 0" range="-2.792 2.809"
                               actuatorfrcrange="-76.4 76.4"/>
                        <geom type="mesh" mesh="hr_knee" class="visual"/>
                        <geom size="0.03 0.0125 0.125" pos="-0.015 0.015 -0.125" type="box" class="collision"/>
                        <geom size="0.04 0.05" pos="0 -0.02 -0.25" quat="0.707107 0.707107 0 0" type="cylinder"
                              class="collision"/>
                        <!-- ==================== hr_wheel：右后轮 ==================== -->
                        <body name="hr_wheel" pos="0 -0.059676 -0.25">
                            <inertial pos="6.09746e-07 -0.000279009 2.01314e-07" quat="0.707107 0 0 0.707107"
                                      mass="0.638"
                                      diaginertia="0.002853 0.001535 0.001535"/>
                            <joint name="hr_wheel_joint" pos="0 0 0" axis="0 -1 0" actuatorfrcrange="-21.6 21.6"/>
                            <geom type="mesh" mesh="hr_wheel" class="visual"/>
                            <geom size="0.09 0.027" quat="0.707107 0.707107 0 0" type="cylinder" class="collision"/>
                        </body>
                    </body>
                </body>
            </body>
        </body>
    </worldbody>

    <!-- ==================== 执行器（16 个电机） ==================== -->
    <!-- 顺序与 dynamics.py 的 JOINT_NAMES 一致：
         fl(hipx/hipy/knee/wheel)、fr(...)、hl(...)、hr(...)。
         腿部电机限幅 ±76.4 N·m，轮子电机 ±21.6 N·m，gear=1。 -->
    <actuator>
        <motor name="fl_hipx_joint" joint="fl_hipx_joint" ctrllimited="true" ctrlrange="-76.4 76.4" gear="1"/>
        <motor name="fl_hipy_joint" joint="fl_hipy_joint" ctrllimited="true" ctrlrange="-76.4 76.4" gear="1"/>
        <motor name="fl_knee_joint" joint="fl_knee_joint" ctrllimited="true" ctrlrange="-76.4 76.4" gear="1"/>
        <motor name="fl_wheel_joint" joint="fl_wheel_joint" ctrllimited="true" ctrlrange="-21.6 21.6" gear="1"/>
        <motor name="fr_hipx_joint" joint="fr_hipx_joint" ctrllimited="true" ctrlrange="-76.4 76.4" gear="1"/>
        <motor name="fr_hipy_joint" joint="fr_hipy_joint" ctrllimited="true" ctrlrange="-76.4 76.4" gear="1"/>
        <motor name="fr_knee_joint" joint="fr_knee_joint" ctrllimited="true" ctrlrange="-76.4 76.4" gear="1"/>
        <motor name="fr_wheel_joint" joint="fr_wheel_joint" ctrllimited="true" ctrlrange="-21.6 21.6" gear="1"/>
        <motor name="hl_hipx_joint" joint="hl_hipx_joint" ctrllimited="true" ctrlrange="-76.4 76.4" gear="1"/>
        <motor name="hl_hipy_joint" joint="hl_hipy_joint" ctrllimited="true" ctrlrange="-76.4 76.4" gear="1"/>
        <motor name="hl_knee_joint" joint="hl_knee_joint" ctrllimited="true" ctrlrange="-76.4 76.4" gear="1"/>
        <motor name="hl_wheel_joint" joint="hl_wheel_joint" ctrllimited="true" ctrlrange="-21.6 21.6" gear="1"/>
        <motor name="hr_hipx_joint" joint="hr_hipx_joint" ctrllimited="true" ctrlrange="-76.4 76.4" gear="1"/>
        <motor name="hr_hipy_joint" joint="hr_hipy_joint" ctrllimited="true" ctrlrange="-76.4 76.4" gear="1"/>
        <motor name="hr_knee_joint" joint="hr_knee_joint" ctrllimited="true" ctrlrange="-76.4 76.4" gear="1"/>
        <motor name="hr_wheel_joint" joint="hr_wheel_joint" ctrllimited="true" ctrlrange="-21.6 21.6" gear="1"/>
    </actuator>

    <!-- ==================== 接触排除 ==================== -->
    <!-- 排除同一腿相邻连杆之间的接触（四腿 × 4 组），
         避免相邻碰撞体互相干涉影响运动。 -->
    <contact>
        <exclude body1="base_link" body2="fl_hipx"/>
        <exclude body1="fl_hipx" body2="fl_hipy"/>
        <exclude body1="fl_hipy" body2="fl_knee"/>
        <exclude body1="fl_knee" body2="fl_wheel"/>

        <exclude body1="base_link" body2="fr_hipx"/>
        <exclude body1="fr_hipx" body2="fr_hipy"/>
        <exclude body1="fr_hipy" body2="fr_knee"/>
        <exclude body1="fr_knee" body2="fr_wheel"/>

        <exclude body1="base_link" body2="hl_hipx"/>
        <exclude body1="hl_hipx" body2="hl_hipy"/>
        <exclude body1="hl_hipy" body2="hl_knee"/>
        <exclude body1="hl_knee" body2="hl_wheel"/>

        <exclude body1="base_link" body2="hr_hipx"/>
        <exclude body1="hr_hipx" body2="hr_hipy"/>
        <exclude body1="hr_hipy" body2="hr_knee"/>
        <exclude body1="hr_knee" body2="hr_wheel"/>

    </contact>

    <!-- ==================== 传感器 ==================== -->
    <!-- base_quat：机身姿态四元数（base_site）；加速度计与陀螺仪挂载于
         imu_site。sensordata 布局（后端读取顺序）：
         [0:4]=四元数(wxyz), [4:7]=加速度, [7:10]=角速度。 -->
    <sensor>
        <!--        <framepos name="base_pos" objtype="site" objname="base_site"/>-->
        <framequat name="base_quat" objtype="site" objname="base_site"/>
        <!--        <framelinvel name="base_linvel" objtype="site" objname="base_site"/>-->
        <!--        <frameangvel name="base_angvel" objtype="site" objname="base_site"/>-->
        <!--        <velocimeter name="base_vel" site="base_site"/>-->
        <accelerometer site="imu_site"/>
        <gyro site="imu_site"/>

    </sensor>
</mujoco>

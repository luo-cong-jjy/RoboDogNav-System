<?xml version="1.0" encoding="UTF-8" ?>
<!-- ======================================================================
     stair.xml —— 官方固定台阶地形模型（中文注释版）
     作用：定义一组固定尺寸的台阶（6 级 + 末端平台），供 stair_official
           地形与 M20_stair.xml 组合模型使用。
     说明：本文件只新增中文注释，未改动任何原始内容
     ====================================================================== -->
<!-- 模型根节点：模型名 stair_terrain -->
<mujoco model="stair_terrain">
    <!-- 全局重力设置：z 轴向下 -9.81 m/s^2 -->
    <option gravity="0 0 -9.81" />

    <!-- 世界坐标系（场景根） -->
    <worldbody>
        <!-- （已注释，备用）平面地面 geom：如不需要台阶可取消注释 -->
        <!-- <geom name="floor" type="plane" pos="0 0 0" size="15 15 0.1" rgba="0.8 0.9 0.8 1"/> -->

        <!-- stair  -->
        <!-- 台阶父 body：整体位于 x=0.8 处 -->
        <body name="staircase" pos="0.8 0 0">
            <!-- 第 1 级台阶：高 0.05，中心 x=0.5（半宽 0.15，半高 0.05） -->
            <geom name="stair1" type="box" pos="0.5 0 0.05" size="0.15 3.0 0.05" rgba="0.5 0.5 0.5 1"/>
            <!-- 第 2 级台阶：高 0.15（累加 0.1），中心 x=0.8 -->
            <geom name="stair2" type="box" pos="0.8 0 0.15" size="0.15 3.0 0.05" rgba="0.5 0.5 0.5 1"/>
            <!-- 第 3 级台阶：高 0.25，中心 x=1.1 -->
            <geom name="stair3" type="box" pos="1.1 0 0.25" size="0.15 3.0 0.05" rgba="0.5 0.5 0.5 1"/>
            <!-- 第 4 级台阶：高 0.35，中心 x=1.4 -->
            <geom name="stair4" type="box" pos="1.4 0 0.35" size="0.15 3.0 0.05" rgba="0.5 0.5 0.5 1"/>
            <!-- 第 5 级台阶：高 0.45，中心 x=1.7 -->
            <geom name="stair5" type="box" pos="1.7 0 0.45" size="0.15 3.0 0.05" rgba="0.5 0.5 0.5 1"/>
            <!-- 末端平台：高 0.55，中心 x=4.35（宽 5.0） -->
            <geom name="stair6" type="box" pos="4.35 0 0.55" size="2.5 3.0 0.05" rgba="0.5 0.5 0.5 1"/>
        </body>
    </worldbody>
</mujoco>

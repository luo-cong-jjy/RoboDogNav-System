<?xml version="1.0" encoding="UTF-8" ?>
<!-- ======================================================================
     M20_stair.xml —— M20 机器人 + 官方台阶地形组合模型（中文注释版）
     作用：通过 <include> 把机器人本体（M20.xml）、场景网格（scene.xml）
           与台阶地形（stair.xml）组合成一个完整 MJCF 模型，
           用于"官方台阶"（stair_official）地形的训练/评估/回放。
     说明：本文件只新增中文注释，未改动任何原始内容
     ====================================================================== -->
<!-- 模型根节点：模型名 M20_stair -->
<mujoco model="M20_stair">
    <!-- 包含机器人本体模型（自由关节机身 + 4 腿 16 关节 + 执行器 + 传感器） -->
    <include file="./M20.xml"/>
    <!-- 包含场景模型（大量 STL 网格资产构成的环境场景） -->
    <include file="./scene.xml"/>
    <!-- 包含台阶地形模型（固定 6 级台阶的 staircase body） -->
    <include file="./stair.xml"/>
</mujoco>

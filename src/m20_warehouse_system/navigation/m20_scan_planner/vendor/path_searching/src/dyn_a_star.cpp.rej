-{
+bool AStar::ConvertToIndexAndAdjustStartEndPoints(Vector3d start_pt, Vector3d end_pt, Vector3i &start_idx, Vector3i &end_idx)
+{
     if (!Coord2Index(start_pt, start_idx) || !Coord2Index(end_pt, end_idx))

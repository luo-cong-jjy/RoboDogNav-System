-void AStar::initGridMap(GridMap::Ptr occ_map, const Eigen::Vector3i pool_size)
-{
-    POOL_SIZE_ = pool_size;
+void AStar::initGridMap(GridMap::Ptr occ_map, const Eigen::Vector3i pool_size)
+{
+    // A* 使用预分配节点池，避免每次碰撞段搜索都动态分配大量 GridNode。
+    // 真实搜索窗口由 start/end 的中点 center_ 和 step_size_ 映射到这个节点池。
+    POOL_SIZE_ = pool_size;
     CENTER_IDX_ = pool_size / 2;
 
     GridNodeMap_ = new GridNodePtr **[POOL_SIZE_(0)];
@@ -91,8 +93,8 @@ vector<GridNodePtr> AStar::retrievePath(GridNodePtr current)
     return path;
 }
 

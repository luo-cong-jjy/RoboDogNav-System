-    occ = checkOccupancy(Index2Coord(end_idx), path_yaw);
-    if (occ)
-    {
-        //ROS_WARN("End point is insdide an obstacle.");
+    occ = checkOccupancy(Index2Coord(end_idx), path_yaw);
+    if (occ)
+    {
+        // 碰撞段出口同理，沿搜索方向向外推到自由栅格，保证 A* 有合法终点。
+        //ROS_WARN("End point is insdide an obstacle.");
         do
         {
             end_pt += start_to_end * step_size_;
@@ -143,8 +147,8 @@ bool AStar::ConvertToIndexAndAdjustStartEndPoints(Vector3d start_pt, Vector3d en
     return true;
 }
 

"""Print deterministic M20 straight-passage clearance limits."""

import argparse
from pathlib import Path

from ament_index_python.packages import get_package_share_directory

from m20_scan_navigation.clearance import (
    load_clearance_profile,
    passage_table,
)


def main() -> int:
    parser = argparse.ArgumentParser(
        description='Report M20 straight-passage clearance limits.'
    )
    parser.add_argument(
        '--profile',
        choices=('vendor', 'm20', 'tight', 'balanced', 'conservative'),
        default='m20',
    )
    parser.add_argument(
        '--width',
        action='append',
        type=float,
        dest='widths',
        help='passage width in metres; repeat as needed',
    )
    parser.add_argument(
        '--map-resolution',
        type=float,
        default=0.05,
        help='occupancy resolution in metres; default is benchmark 0.05',
    )
    options = parser.parse_args()
    share = Path(
        get_package_share_directory('m20_scan_navigation')
    )
    profile = load_clearance_profile(
        share / 'config' / f'clearance_{options.profile}.yaml'
    )
    widths = options.widths or (0.60, 0.65, 0.70, 0.75, 0.80, 0.90)
    print(f'profile={profile.name}')
    print(
        f'physical_body={profile.physical_minimum_width:.2f}m '
        f'scan_hard_body={profile.scan_hard_length:.2f}x'
        f'{profile.scan_hard_width:.2f}m '
        f'axial_cover={profile.scan_covers_physical_body} '
        f'native_hard={profile.native_hard_width:.2f}m '
        f'native_nominal={profile.native_nominal_width:.2f}m '
        f'online_guard_requires>'
        f'{profile.raster_guard_exclusive_width(options.map_resolution):.2f}m'
    )
    for width, status in passage_table(
        profile,
        widths,
        map_resolution=options.map_resolution,
    ):
        print(f'{width:.2f}m {status}')
    print(
        'NOMINAL_CANDIDATE is a parameter-level result; use the controlled '
        'MuJoCo corridor test before approving a real-site width.'
    )
    return 0


if __name__ == '__main__':
    raise SystemExit(main())

<?xml version="1.0"?>
<!--
  Compatibility entry point. It intentionally adds no links, sensors, joints,
  geometry, or kinematic changes to the official Deep Robotics M20 model.
-->
<robot name="M20" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find m20_official_description)/urdf/m20_official.urdf"/>
</robot>

#!/usr/bin/python3

import math

import rclpy
from geometry_msgs.msg import Twist
from nav_msgs.msg import Odometry
from rclpy.node import Node


DEFAULT_WAYPOINTS = (
    "0,0;20,0;20,4;0,4;0,8;20,8;"
    "20,12;0,12;0,16;20,16;20,20;0,20"
)


def clamp(value, lower, upper):
    return max(lower, min(upper, value))


def normalize_angle(angle):
    while angle > math.pi:
        angle -= 2.0 * math.pi
    while angle < -math.pi:
        angle += 2.0 * math.pi
    return angle


def yaw_from_quaternion(q):
    siny_cosp = 2.0 * (q.w * q.z + q.x * q.y)
    cosy_cosp = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)
    return math.atan2(siny_cosp, cosy_cosp)


def parse_waypoints(text):
    waypoints = []
    for raw_item in str(text).replace("|", ";").split(";"):
        item = raw_item.strip()
        if not item:
            continue
        parts = item.replace(",", " ").split()
        if len(parts) != 2:
            raise ValueError(f"Invalid waypoint '{item}', expected 'x,y'")
        waypoints.append((float(parts[0]), float(parts[1])))
    return waypoints


class OdomWaypointFollower(Node):
    def __init__(self):
        super().__init__("odom_waypoint_follower")
        self.odom_topic = self.declare_parameter("odom_topic", "/odom").value
        self.cmd_topic = self.declare_parameter("cmd_topic", "/cmd_vel").value
        self.waypoints = parse_waypoints(
            self.declare_parameter("waypoints", DEFAULT_WAYPOINTS).value
        )
        self.goal_tolerance = float(self.declare_parameter("goal_tolerance", 0.35).value)
        self.max_linear = float(self.declare_parameter("max_linear", 0.28).value)
        self.max_angular = float(self.declare_parameter("max_angular", 0.75).value)
        self.min_angular = float(self.declare_parameter("min_angular", 0.16).value)
        self.heading_kp = float(self.declare_parameter("heading_kp", 1.8).value)
        self.slowdown_radius = float(self.declare_parameter("slowdown_radius", 1.2).value)
        self.rotate_in_place_angle = float(
            self.declare_parameter("rotate_in_place_angle", 0.55).value
        )
        self.control_rate_hz = float(self.declare_parameter("control_rate_hz", 20.0).value)
        self.loop = bool(self.declare_parameter("loop", False).value)

        if not self.waypoints:
            raise ValueError("No waypoints configured")

        self.pose = None
        self.current_index = 0
        self.done = False

        self.cmd_pub = self.create_publisher(Twist, self.cmd_topic, 10)
        self.odom_sub = self.create_subscription(
            Odometry, self.odom_topic, self._on_odom, 20
        )
        self.timer = self.create_timer(1.0 / self.control_rate_hz, self._control)

        self.get_logger().info(
            f"odom 航点跟随已启动：{len(self.waypoints)} 个点，"
            f"{self.odom_topic} -> {self.cmd_topic}"
        )
        self._log_current_goal()

    def _on_odom(self, msg):
        pose = msg.pose.pose
        self.pose = (
            pose.position.x,
            pose.position.y,
            yaw_from_quaternion(pose.orientation),
        )

    def _control(self):
        if self.pose is None or self.done:
            return

        x, y, yaw = self.pose
        goal_x, goal_y = self.waypoints[self.current_index]
        dx = goal_x - x
        dy = goal_y - y
        distance = math.hypot(dx, dy)

        if distance <= self.goal_tolerance:
            self.get_logger().info(
                f"到达航点 {self.current_index + 1}/{len(self.waypoints)}: "
                f"({goal_x:.2f}, {goal_y:.2f})"
            )
            self.current_index += 1
            self._publish_stop()
            if self.current_index >= len(self.waypoints):
                if self.loop:
                    self.current_index = 0
                else:
                    self.done = True
                    self.get_logger().info("odom 航点路线完成，已停止。")
                    return
            self._log_current_goal()
            return

        target_yaw = math.atan2(dy, dx)
        heading_error = normalize_angle(target_yaw - yaw)
        angular = clamp(
            self.heading_kp * heading_error,
            -self.max_angular,
            self.max_angular,
        )
        if abs(angular) > 1.0e-3:
            angular = math.copysign(max(abs(angular), self.min_angular), angular)

        if abs(heading_error) > self.rotate_in_place_angle:
            linear = 0.0
        else:
            distance_scale = clamp(distance / self.slowdown_radius, 0.15, 1.0)
            heading_scale = clamp(math.cos(heading_error), 0.0, 1.0)
            linear = self.max_linear * distance_scale * heading_scale

        cmd = Twist()
        cmd.linear.x = linear
        cmd.angular.z = angular
        self.cmd_pub.publish(cmd)

    def _log_current_goal(self):
        goal_x, goal_y = self.waypoints[self.current_index]
        self.get_logger().info(
            f"目标航点 {self.current_index + 1}/{len(self.waypoints)}: "
            f"({goal_x:.2f}, {goal_y:.2f})"
        )

    def _publish_stop(self):
        self.cmd_pub.publish(Twist())


def main():
    rclpy.init()
    node = OdomWaypointFollower()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node._publish_stop()
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()

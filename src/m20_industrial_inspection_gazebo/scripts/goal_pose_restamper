#!/usr/bin/python3

import rclpy
from geometry_msgs.msg import PoseStamped
from rclpy.node import Node


class GoalPoseRestamper(Node):
    def __init__(self):
        super().__init__("goal_pose_restamper")
        self.input_topic = self.declare_parameter(
            "input_topic", "/m20_nav2/goal_pose_raw"
        ).value
        self.output_topic = self.declare_parameter("output_topic", "/goal_pose").value
        self.use_zero_stamp = bool(self.declare_parameter("use_zero_stamp", True).value)

        self.publisher = self.create_publisher(PoseStamped, self.output_topic, 10)
        self.subscription = self.create_subscription(
            PoseStamped, self.input_topic, self._on_goal, 10
        )

        self.get_logger().info(
            f"目标点时间戳转发已启动：{self.input_topic} -> {self.output_topic}"
        )

    def _on_goal(self, msg):
        goal = PoseStamped()
        goal.header = msg.header
        goal.pose = msg.pose

        # RViz 目标点在恢复行为后可能变成旧时间戳；stamp=0 让 TF 使用最新变换。
        if self.use_zero_stamp:
            goal.header.stamp.sec = 0
            goal.header.stamp.nanosec = 0
        else:
            goal.header.stamp = self.get_clock().now().to_msg()

        self.publisher.publish(goal)
        self.get_logger().info(
            "转发目标点："
            f"frame={goal.header.frame_id}, "
            f"x={goal.pose.position.x:.2f}, "
            f"y={goal.pose.position.y:.2f}, "
            f"stamp={goal.header.stamp.sec}.{goal.header.stamp.nanosec:09d}"
        )


def main():
    rclpy.init()
    node = GoalPoseRestamper()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()

<?xml version="1.0"?>
<sdf version="1.6">
  <world name="factory_environment_v3_dynamic_obstacles">
    <!-- Direct Light to prevent online fetching -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision">
          <geometry><box><size>26 26 0.05</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>26 26 0.05</size></box></geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>10 10 -0.025 0 0 0</pose>
    </model>

    <!-- Walls -->
    <model name="north_wall">
      <static>true</static>
      <pose>10 22 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>24 0.25 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>24 0.25 3.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="south_wall">
      <static>true</static>
      <pose>10 -2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>24 0.25 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>24 0.25 3.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="west_wall">
      <static>true</static>
      <pose>-2 10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.25 24 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.25 24 3.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="east_wall">
      <static>true</static>
      <pose>22 10 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.25 24 3.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.25 24 3.0</size></box></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- 5 Rows of Desks/Machines with 4m spacing -->
    <model name="desk_row_1">
      <static>true</static>
      <pose>10 18 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 1.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 1.2 1.2</size></box></geometry><material><ambient>0.4 0.5 0.6 1</ambient><diffuse>0.4 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="desk_row_2">
      <static>true</static>
      <pose>10 14 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 1.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 1.2 1.2</size></box></geometry><material><ambient>0.4 0.5 0.6 1</ambient><diffuse>0.4 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="desk_row_3">
      <static>true</static>
      <pose>10 10 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 1.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 1.2 1.2</size></box></geometry><material><ambient>0.4 0.5 0.6 1</ambient><diffuse>0.4 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="desk_row_4">
      <static>true</static>
      <pose>10 6 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 1.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 1.2 1.2</size></box></geometry><material><ambient>0.4 0.5 0.6 1</ambient><diffuse>0.4 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>
    <model name="desk_row_5">
      <static>true</static>
      <pose>10 2 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16 1.2 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>16 1.2 1.2</size></box></geometry><material><ambient>0.4 0.5 0.6 1</ambient><diffuse>0.4 0.5 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!--
    ============================================================
    轨迹规划 v3 — 动态障碍物穿越巡检路线段，但避开配置点
    ============================================================
    禁止覆盖的点来自 factory_inspection_midpoints.yaml：
      X=0,10,20 三列与 Y=0,4,8,12,16,20 六行的交点。

    设计原则：
      1. 动态障碍物可以进入巡检路线段，制造真实避障压力。
      2. 动态障碍物轨迹不经过巡检点和转弯点本身。
      3. 不使用透明材质；Gazebo 中看到的障碍物就是 /scan 中的障碍物。
      4. 使用圆柱、方形柱体、长方体小车等不同尺寸和规格。
      5. M20 机身长度约 0.75m，转弯点周围保留约 1.0m 以上障碍物本体净空。
      6. M20 线速度上限为 0.45m/s，动态障碍物速度控制在约 0.20~0.25m/s。
      7. M20 2D 雷达高度约 0.81m，所有动态障碍物高度均穿过该扫描平面。
    ============================================================
    -->

    <!-- ==================== DYNAMIC ROUTE OBSTACLES ==================== -->

    <!-- Route y=4, west half: cylinder crosses the route but avoids x=0/10/20. -->
    <model name="dyn_cylinder_y04_west">
      <static>false</static>
      <pose>3 4 0.70 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><cylinder><radius>0.28</radius><length>1.40</length></cylinder></geometry>
          <surface><contact><collide_without_contact>false</collide_without_contact></contact><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.28</radius><length>1.40</length></cylinder></geometry>
          <material><ambient>0.90 0.10 0.10 1</ambient><diffuse>0.90 0.10 0.10 1</diffuse></material>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 3 4 0.70 0 0 0;20 8 4 0.70 0 0 0;22 8 4 0.70 0 0 3.14159;42 3 4 0.70 0 0 3.14159;44 3 4 0.70 0 0 6.28318</trajectory>
      </plugin>
    </model>

    <!-- Route y=4, east half: rectangular cart. -->
    <model name="dyn_cart_y04_east">
      <static>false</static>
      <pose>17 4 0.65 0 0 3.14159</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><box><size>1.10 0.55 1.30</size></box></geometry>
          <surface><contact><collide_without_contact>false</collide_without_contact></contact><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.10 0.55 1.30</size></box></geometry>
          <material><ambient>0.95 0.70 0.10 1</ambient><diffuse>0.95 0.70 0.10 1</diffuse></material>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 17 4 0.65 0 0 3.14159;22 12 4 0.65 0 0 3.14159;24 12 4 0.65 0 0 6.28318;46 17 4 0.65 0 0 6.28318;48 17 4 0.65 0 0 9.42477</trajectory>
      </plugin>
    </model>

    <!-- Route y=8, west half: square pillar. -->
    <model name="dyn_square_pillar_y08_west">
      <static>false</static>
      <pose>3 8 0.70 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><box><size>0.65 0.65 1.40</size></box></geometry>
          <surface><contact><collide_without_contact>false</collide_without_contact></contact><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.65 0.65 1.40</size></box></geometry>
          <material><ambient>0.10 0.55 0.85 1</ambient><diffuse>0.10 0.55 0.85 1</diffuse></material>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 3 8 0.70 0 0 0;24 8 8 0.70 0 0 0;26 8 8 0.70 0 0 3.14159;50 3 8 0.70 0 0 3.14159;52 3 8 0.70 0 0 6.28318</trajectory>
      </plugin>
    </model>

    <!-- Route y=12, east half: large cylinder. -->
    <model name="dyn_cylinder_y12_east">
      <static>false</static>
      <pose>12 12 0.60 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><cylinder><radius>0.36</radius><length>1.20</length></cylinder></geometry>
          <surface><contact><collide_without_contact>false</collide_without_contact></contact><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.36</radius><length>1.20</length></cylinder></geometry>
          <material><ambient>0.55 0.20 0.80 1</ambient><diffuse>0.55 0.20 0.80 1</diffuse></material>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 12 12 0.60 0 0 0;20 17 12 0.60 0 0 0;22 17 12 0.60 0 0 3.14159;42 12 12 0.60 0 0 3.14159;44 12 12 0.60 0 0 6.28318</trajectory>
      </plugin>
    </model>

    <!-- Route y=16, west half: low rectangular cart. -->
    <model name="dyn_cart_y16_west">
      <static>false</static>
      <pose>8 16 0.65 0 0 3.14159</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><box><size>0.75 0.45 1.30</size></box></geometry>
          <surface><contact><collide_without_contact>false</collide_without_contact></contact><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.75 0.45 1.30</size></box></geometry>
          <material><ambient>0.15 0.70 0.25 1</ambient><diffuse>0.15 0.70 0.25 1</diffuse></material>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 8 16 0.65 0 0 3.14159;22 3 16 0.65 0 0 3.14159;24 3 16 0.65 0 0 6.28318;46 8 16 0.65 0 0 6.28318;48 8 16 0.65 0 0 9.42477</trajectory>
      </plugin>
    </model>

    <!-- Route y=20, east half: tall square pillar. -->
    <model name="dyn_square_pillar_y20_east">
      <static>false</static>
      <pose>12 20 0.80 0 0 0</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><box><size>0.75 0.75 1.60</size></box></geometry>
          <surface><contact><collide_without_contact>false</collide_without_contact></contact><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.75 0.75 1.60</size></box></geometry>
          <material><ambient>0.85 0.35 0.10 1</ambient><diffuse>0.85 0.35 0.10 1</diffuse></material>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 12 20 0.80 0 0 0;24 17 20 0.80 0 0 0;26 17 20 0.80 0 0 3.14159;50 12 20 0.80 0 0 3.14159;52 12 20 0.80 0 0 6.28318</trajectory>
      </plugin>
    </model>

    <!-- Vertical turn corridor x=20, between y=0 and y=4. -->
    <model name="dyn_cylinder_x20_lower">
      <static>false</static>
      <pose>20 1.7 0.70 0 0 1.5708</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><cylinder><radius>0.28</radius><length>1.40</length></cylinder></geometry>
          <surface><contact><collide_without_contact>false</collide_without_contact></contact><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.28</radius><length>1.40</length></cylinder></geometry>
          <material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 20 1.7 0.70 0 0 1.5708;3 20 2.3 0.70 0 0 1.5708;5 20 2.3 0.70 0 0 4.71239;8 20 1.7 0.70 0 0 4.71239;10 20 1.7 0.70 0 0 7.85398</trajectory>
      </plugin>
    </model>

    <!-- Vertical turn corridor x=0, between y=4 and y=8. -->
    <model name="dyn_box_x00_04_08">
      <static>false</static>
      <pose>0 5.7 0.65 0 0 1.5708</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><box><size>0.70 0.45 1.30</size></box></geometry>
          <surface><contact><collide_without_contact>false</collide_without_contact></contact><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.70 0.45 1.30</size></box></geometry>
          <material><ambient>0.30 0.65 0.85 1</ambient><diffuse>0.30 0.65 0.85 1</diffuse></material>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 0 5.7 0.65 0 0 1.5708;3 0 6.3 0.65 0 0 1.5708;5 0 6.3 0.65 0 0 4.71239;8 0 5.7 0.65 0 0 4.71239;10 0 5.7 0.65 0 0 7.85398</trajectory>
      </plugin>
    </model>

    <!-- Vertical turn corridor x=20, between y=8 and y=12. -->
    <model name="dyn_square_x20_08_12">
      <static>false</static>
      <pose>20 9.7 0.75 0 0 1.5708</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><box><size>0.65 0.65 1.50</size></box></geometry>
          <surface><contact><collide_without_contact>false</collide_without_contact></contact><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.65 0.65 1.50</size></box></geometry>
          <material><ambient>0.80 0.20 0.65 1</ambient><diffuse>0.80 0.20 0.65 1</diffuse></material>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 20 9.7 0.75 0 0 1.5708;3 20 10.3 0.75 0 0 1.5708;5 20 10.3 0.75 0 0 4.71239;8 20 9.7 0.75 0 0 4.71239;10 20 9.7 0.75 0 0 7.85398</trajectory>
      </plugin>
    </model>

    <!-- Vertical turn corridor x=0, between y=12 and y=16. -->
    <model name="dyn_cart_x00_12_16">
      <static>false</static>
      <pose>0 13.7 0.65 0 0 1.5708</pose>
      <link name="body">
        <gravity>false</gravity>
        <collision name="collision">
          <geometry><box><size>0.80 0.45 1.30</size></box></geometry>
          <surface><contact><collide_without_contact>false</collide_without_contact></contact><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.80 0.45 1.30</size></box></geometry>
          <material><ambient>0.75 0.75 0.15 1</ambient><diffuse>0.75 0.75 0.15 1</diffuse></material>
        </visual>
      </link>
      <plugin name="waypoint_motion" filename="libm20_waypoint_obstacle_plugin.so">
        <loop>true</loop>
        <trajectory>0 0 13.7 0.65 0 0 1.5708;3 0 14.3 0.65 0 0 1.5708;5 0 14.3 0.65 0 0 4.71239;8 0 13.7 0.65 0 0 4.71239;10 0 13.7 0.65 0 0 7.85398</trajectory>
      </plugin>
    </model>

  </world>
</sdf>
